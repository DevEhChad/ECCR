<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:ECCR.Converters"
             x:Class="ECCR.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <converters:ButtonBadgeConverter x:Key="ButtonBadgeConverter"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/ECCR-logo.ico" 
                      ToolTipText="EhChadsControllerRemapper - ECCR"
                      Clicked="OnTrayIconClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Open ECCR" Click="OnOpenClicked"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Exit ECCR" Click="OnExitClicked"/>
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>