<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ECCR.ViewModels"
        xmlns:models="using:ECCR.Models"
        xmlns:services="using:ECCR.Services"
        xmlns:converters="using:ECCR.Converters"
        x:Class="ECCR.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="RootWindow"
        Background="#0E1118"
        Foreground="White"
        Icon="/Assets/ECCR-logo.ico"
        Title="EhChadsControllerRemapper - ECCR"
        FontSize="14">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid>
        <!-- Main Application Layout -->
        <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="16,12">
            
            <!-- ROW 0: Dependency Banner -->
            <Border Grid.Row="0" 
                    IsVisible="{Binding IsDependencyBannerOpen}" 
                    Background="#241519" 
                    BorderBrush="#552229" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="14,10" 
                    Margin="0,0,0,10">
                <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                    <TextBlock Grid.Column="0" Text="⚠️" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="System Driver Status &amp; Missing Services" FontWeight="Bold" FontSize="13" Foreground="#FFAAAA"/>
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <TextBlock Text="ViGEmBus: " FontSize="11" Foreground="#888899"/>
                                <TextBlock Text="Not Installed" Foreground="#FF6B6B" FontSize="11" FontWeight="SemiBold" IsVisible="{Binding !IsViGEmInstalled}"/>
                                <TextBlock Text="Active" Foreground="#00E599" FontSize="11" FontWeight="SemiBold" IsVisible="{Binding IsViGEmInstalled}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <TextBlock Text="HidHide: " FontSize="11" Foreground="#888899"/>
                                <TextBlock Text="Not Installed" Foreground="#FF6B6B" FontSize="11" FontWeight="SemiBold" IsVisible="{Binding !IsHidHideServiceInstalled}"/>
                                <TextBlock Text="Active" Foreground="#00E599" FontSize="11" FontWeight="SemiBold" IsVisible="{Binding IsHidHideServiceInstalled}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="vJoy: " FontSize="11" Foreground="#888899"/>
                                <TextBlock Text="Not Installed" Foreground="#FF6B6B" FontSize="11" FontWeight="SemiBold" IsVisible="{Binding !IsVJoyInstalled}"/>
                                <TextBlock Text="Active" Foreground="#00E599" FontSize="11" FontWeight="SemiBold" IsVisible="{Binding IsVJoyInstalled}"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="10,0">
                        <Button Content="+ Install ViGEm" Command="{Binding InstallViGEmCommand}" 
                                IsVisible="{Binding !IsViGEmInstalled}" IsEnabled="{Binding !IsBusyWithDriverAction}"
                                Background="#3E7BFA" Foreground="White" FontSize="11" Padding="8,4" CornerRadius="4"/>
                        <Button Content="+ Install HidHide" Command="{Binding InstallHidHideCommand}" 
                                IsVisible="{Binding !IsHidHideServiceInstalled}" IsEnabled="{Binding !IsBusyWithDriverAction}"
                                Background="#7A3EFA" Foreground="White" FontSize="11" Padding="8,4" CornerRadius="4"/>
                        <Button Content="+ Install vJoy" Command="{Binding InstallVJoyCommand}" 
                                IsVisible="{Binding !IsVJoyInstalled}" IsEnabled="{Binding !IsBusyWithDriverAction}"
                                Background="#00B074" Foreground="White" FontSize="11" Padding="8,4" CornerRadius="4"/>
                    </StackPanel>

                    <Button Grid.Column="3" Content="✕" Command="{Binding DismissDependencyBannerCommand}" 
                            Background="Transparent" Foreground="#FFAAAA" Padding="6,2" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ROW 1: Headers with Native Vector Logo -->
            <Grid Grid.Row="1" ColumnDefinitions="1.8*, 0.9*, 1.1*, 1.8*, 1.4*, 1*, 36" Margin="14,0,14,8">
                <Border Grid.ColumnSpan="7" BorderThickness="0,0,0,2" BorderBrush="#262D3D" Padding="0,0,0,8"/>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <!-- Native XAML ECCR Vector Logo -->
                    <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                        <Canvas Width="48" Height="48">
                            <Ellipse Canvas.Left="2" Canvas.Top="2" Width="44" Height="44" Stroke="#3E7BFA" StrokeThickness="3.5" Fill="#121620"/>
                            <Rectangle Canvas.Left="12" Canvas.Top="14" Width="24" Height="20" RadiusX="6" RadiusY="6" Fill="#1E2B45" Stroke="#00E599" StrokeThickness="1.5"/>
                            <Rectangle Canvas.Left="16" Canvas.Top="21" Width="4" Height="6" Fill="#BAC2DE"/>
                            <Rectangle Canvas.Left="15" Canvas.Top="22" Width="6" Height="4" Fill="#BAC2DE"/>
                            <Ellipse Canvas.Left="28" Canvas.Top="20" Width="3" Height="3" Fill="#FF4D6D"/>
                            <Ellipse Canvas.Left="26" Canvas.Top="23" Width="3" Height="3" Fill="#3E7BFA"/>
                            <Ellipse Canvas.Left="30" Canvas.Top="23" Width="3" Height="3" Fill="#00E599"/>
                            <Ellipse Canvas.Left="28" Canvas.Top="26" Width="3" Height="3" Fill="#FFB900"/>
                        </Canvas>
                    </Viewbox>
                    <Label FontWeight="SemiBold" Content="Physical Key / Axis" VerticalAlignment="Center"/>
                </StackPanel>

                <Label Grid.Column="1" FontWeight="SemiBold" HorizontalContentAlignment="Center" Content="Type"/>
                <Label Grid.Column="2" FontWeight="SemiBold" HorizontalContentAlignment="Center" Content="Virtual Target"/>
                <Label Grid.Column="3" FontWeight="SemiBold" HorizontalContentAlignment="Center" Content="Channel"/>
                <Label Grid.Column="4" FontWeight="SemiBold" HorizontalContentAlignment="Center" Content="Dead Zone"/>
                <Label Grid.Column="5" FontWeight="SemiBold" HorizontalContentAlignment="Center" Content="Calibration"/>
                <Label Grid.Column="6"/>
            </Grid>

            <!-- ROW 2: Collapsible Device Mapping Groups -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,4">
                <ItemsControl ItemsSource="{Binding GroupedMappings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:DeviceMappingGroup">
                            <Border Background="#121622" BorderBrush="#20283C" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10">
                                <Expander IsExpanded="{Binding IsExpanded}" 
                                          HorizontalAlignment="Stretch" 
                                          HorizontalContentAlignment="Stretch"
                                          Background="Transparent" 
                                          BorderThickness="0" 
                                          Padding="0">
                                    
                                    <Expander.Header>
                                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" HorizontalAlignment="Stretch" Margin="0,2">
                                            <Border Grid.Column="0" Background="#1E2B45" CornerRadius="5" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="🎮 DEVICE" FontSize="10" FontWeight="Bold" Foreground="#3E7BFA"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DeviceName}" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                                <Border Background="#1A202E" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding EntryCount, StringFormat='{}{0} Binds Active'}" FontSize="11" Foreground="#8B95A5"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Bulk Change All Targets for Device -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <TextBlock Text="Set All Target:" FontSize="11" Foreground="#8B95A5" VerticalAlignment="Center"/>
                                                <ComboBox ItemsSource="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).AvailableTargetDevices}"
                                                          PlaceholderText="Target #"
                                                          Width="120"
                                                          CornerRadius="5"
                                                          Background="#10141E"
                                                          FontSize="11"
                                                          SelectionChanged="OnBulkTargetSelectionChanged">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding StringFormat='Target #{0}'}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>

                                            <Button Grid.Column="3" 
                                                    Content="+ Add Key" 
                                                    Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).AddMappingToDeviceCommand}"
                                                    CommandParameter="{Binding DeviceName}"
                                                    Background="#1F283C" 
                                                    BorderBrush="#3D4B6E" 
                                                    Foreground="White" 
                                                    FontSize="11" 
                                                    Padding="10,4" 
                                                    CornerRadius="5" 
                                                    Margin="0,0,12,0"/>
                                        </Grid>
                                    </Expander.Header>

                                    <!-- Grouped Mapping Matrix Rows -->
                                    <ItemsControl ItemsSource="{Binding Entries}" HorizontalAlignment="Stretch" Margin="8,4,8,10">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:MappingEntry">
                                                <Grid ColumnDefinitions="1.8*, 0.9*, 1.1*, 1.8*, 1.4*, 1*, 36" 
                                                      HorizontalAlignment="Stretch" 
                                                      Margin="0,3">
                                                    
                                                    <!-- Physical Bind Button with Badge -->
                                                    <Button Grid.Column="0" 
                                                            Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).StartListeningCommand}"
                                                            CommandParameter="{Binding}"
                                                            HorizontalAlignment="Stretch" 
                                                            HorizontalContentAlignment="Stretch"
                                                            Margin="3,0" 
                                                            Padding="6,4"
                                                            Background="#1F283C"
                                                            BorderBrush="#3D4B6E"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                        <Grid ColumnDefinitions="Auto, *">
                                                            <Border Grid.Column="0" 
                                                                    x:DataType="converters:BadgeInfo"
                                                                    DataContext="{Binding $parent[Button].((models:MappingEntry)DataContext).SourceDisplayName, Converter={StaticResource ButtonBadgeConverter}}"
                                                                    IsVisible="{Binding HasBadge}"
                                                                    Background="{Binding Background}"
                                                                    BorderBrush="{Binding Border}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="10"
                                                                    Width="22" Height="22"
                                                                    Margin="0,0,8,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Glyph}" 
                                                                           Foreground="{Binding Foreground}"
                                                                           FontSize="12" 
                                                                           FontWeight="Bold" 
                                                                           HorizontalAlignment="Center" 
                                                                           VerticalAlignment="Center"/>
                                                            </Border>

                                                            <TextBlock Grid.Column="1" 
                                                                       Text="{Binding SourceDisplayName}" 
                                                                       VerticalAlignment="Center" 
                                                                       HorizontalAlignment="Left"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </Button>

                                                    <!-- Input Type -->
                                                    <ComboBox Grid.Column="1" 
                                                              SelectedItem="{Binding SourceType}" 
                                                              HorizontalAlignment="Stretch" 
                                                              Margin="3,0" 
                                                              CornerRadius="6"
                                                              Background="#161B26">
                                                        <models:InputType>Axis</models:InputType>
                                                        <models:InputType>Button</models:InputType>
                                                    </ComboBox>

                                                    <!-- Target Device ID -->
                                                    <ComboBox Grid.Column="2" 
                                                              ItemsSource="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).AvailableTargetDevices}"
                                                              SelectedItem="{Binding TargetDeviceId}"
                                                              HorizontalAlignment="Stretch" 
                                                              Margin="3,0" 
                                                              CornerRadius="6"
                                                              Background="#161B26">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding StringFormat='Target #{0}'}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>

                                                    <!-- Target Output Channel with Badge -->
                                                    <ComboBox Grid.Column="3" 
                                                              ItemsSource="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).AvailableVirtualOutputs}"
                                                              SelectedItem="{Binding TargetOutput}" 
                                                              MaxDropDownHeight="300"
                                                              HorizontalAlignment="Stretch" 
                                                              Margin="3,0" 
                                                              CornerRadius="6"
                                                              Background="#161B26">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <Grid ColumnDefinitions="Auto, *">
                                                                    <Border Grid.Column="0" 
                                                                            x:DataType="converters:BadgeInfo"
                                                                            DataContext="{Binding Converter={StaticResource ButtonBadgeConverter}}"
                                                                            IsVisible="{Binding HasBadge}"
                                                                            Background="{Binding Background}"
                                                                            BorderBrush="{Binding Border}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="10"
                                                                            Width="20" Height="20"
                                                                            Margin="0,0,8,0"
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Glyph}" 
                                                                                   Foreground="{Binding Foreground}"
                                                                                   FontSize="11" 
                                                                                   FontWeight="Bold" 
                                                                                   HorizontalAlignment="Center" 
                                                                                   VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <TextBlock Grid.Column="1" 
                                                                               Text="{Binding}" 
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>

                                                    <!-- Deadzone -->
                                                    <Panel Grid.Column="4" Margin="4,0" HorizontalAlignment="Stretch">
                                                        <Grid ColumnDefinitions="*, 36" IsVisible="{Binding IsAxis}" HorizontalAlignment="Stretch">
                                                            <Slider Grid.Column="0" 
                                                                    Minimum="0.0" 
                                                                    Maximum="0.5" 
                                                                    Value="{Binding Deadzone}" 
                                                                    HorizontalAlignment="Stretch"
                                                                    VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" 
                                                                       Text="{Binding Deadzone, StringFormat='{}{0:P0}'}" 
                                                                       FontSize="11" 
                                                                       Foreground="#8B95A5" 
                                                                       VerticalAlignment="Center" 
                                                                       HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <TextBlock Text="—" 
                                                                   Foreground="#4B5563" 
                                                                   HorizontalAlignment="Center" 
                                                                   VerticalAlignment="Center" 
                                                                   IsVisible="{Binding !IsAxis}"/>
                                                    </Panel>

                                                    <!-- Calibration -->
                                                    <Panel Grid.Column="5" Margin="3,0" HorizontalAlignment="Stretch">
                                                        <Button Content="Calibrate" 
                                                                Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).OpenCalibrationCommand}"
                                                                CommandParameter="{Binding}"
                                                                HorizontalAlignment="Stretch" 
                                                                HorizontalContentAlignment="Center"
                                                                Background="#1B2130"
                                                                BorderBrush="#2B354C"
                                                                CornerRadius="6"
                                                                IsVisible="{Binding IsAxis}"/>
                                                        <TextBlock Text="—" 
                                                                   Foreground="#4B5563" 
                                                                   HorizontalAlignment="Center" 
                                                                   VerticalAlignment="Center" 
                                                                   IsVisible="{Binding !IsAxis}"/>
                                                    </Panel>

                                                    <!-- Delete Row -->
                                                    <Button Grid.Column="6" 
                                                            Content="✕" 
                                                            Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).RemoveMappingCommand}"
                                                            CommandParameter="{Binding}"
                                                            HorizontalAlignment="Center" 
                                                            VerticalAlignment="Center"
                                                            Foreground="#FF5C5C" 
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            FontWeight="Bold"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ROW 3: Footer -->
            <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="#262D3D" Padding="0,14,0,4">
                <StackPanel Spacing="14">
                    
                    <Grid ColumnDefinitions="*, Auto, *, Auto, *">
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="2">
                            <TextBlock Text="ACTIVE VIRTUAL TARGET" FontSize="10" FontWeight="Bold" Foreground="#8B95A5" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding VirtualDeviceSummary}" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <Border Grid.Column="1" Width="1" Height="26" Background="#262D3D"/>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="2">
                            <TextBlock Text="MAPPING STATUS" FontSize="10" FontWeight="Bold" Foreground="#8B95A5" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding MappingStatus}" FontSize="15" FontWeight="SemiBold" Foreground="#00E599" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <Border Grid.Column="3" Width="1" Height="26" Background="#262D3D"/>

                        <StackPanel Grid.Column="4" HorizontalAlignment="Center" Spacing="2">
                            <TextBlock Text="POLL LATENCY" FontSize="10" FontWeight="Bold" Foreground="#8B95A5" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Latency}" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Control Bar with Settings Button -->
                    <Grid ColumnDefinitions="Auto, 130, Auto, Auto, Auto, Auto, Auto, *, 170">
                        <TextBlock Grid.Column="0" Text="Profile" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="#BAC2DE"/>
                        
                        <ComboBox Grid.Column="1" 
                                  ItemsSource="{Binding Profiles}"
                                  SelectedItem="{Binding SelectedProfile}"
                                  HorizontalAlignment="Stretch" 
                                  CornerRadius="6" 
                                  Background="#1B202E" 
                                  BorderBrush="#2F384C"/>

                        <Button Grid.Column="2" 
                                Content="+ New"
                                Command="{Binding OpenCreateProfileDialogCommand}"
                                Margin="6,0,0,0"
                                Padding="8,6"
                                CornerRadius="6"
                                Background="#232A3B"
                                BorderBrush="#3D4B6E"/>

                        <Button Grid.Column="3" 
                                Content="Save"
                                Command="{Binding SaveCurrentProfileCommand}"
                                Margin="6,0,0,0"
                                Padding="10,6"
                                FontWeight="SemiBold"
                                CornerRadius="6"
                                Background="#1A4A38"
                                BorderBrush="#266D53"/>

                        <Button Grid.Column="4" 
                                Content="🛡 HidHide"
                                Command="{Binding OpenHidHideMenuCommand}"
                                Margin="6,0,0,0"
                                Padding="10,6"
                                CornerRadius="6"
                                Background="#2A1B3D"
                                BorderBrush="#5E3B8A"
                                FontWeight="SemiBold"/>

                        <Button Grid.Column="5" 
                                Command="{Binding OpenAutoBindWizardCommand}"
                                Content="⚡ Auto-Bind" 
                                Margin="6,0,0,0"
                                Padding="10,6"
                                CornerRadius="6"
                                Background="#1E2B45"
                                BorderBrush="#3E7BFA"
                                Foreground="#70A0FF"
                                FontWeight="SemiBold"/>

                        <!-- Settings Button -->
                        <Button Grid.Column="6" 
                                Command="{Binding OpenSettingsCommand}"
                                Content="⚙️ Settings" 
                                Margin="6,0,0,0"
                                Padding="10,6"
                                CornerRadius="6"
                                Background="#1F283C" 
                                BorderBrush="#3D4B6E" 
                                Foreground="White"
                                FontWeight="SemiBold"/>

                        <Button Grid.Column="8" 
                                Command="{Binding AddMappingCommand}"
                                Content="+ Add Mapping" 
                                HorizontalAlignment="Stretch" 
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Height="40"
                                FontSize="13"
                                FontWeight="SemiBold"
                                CornerRadius="20" 
                                Background="#2A303F" 
                                Foreground="#FFFFFF" 
                                BorderBrush="#3D4559"
                                BorderThickness="1"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- SETTINGS MODAL -->
        <Border IsVisible="{Binding IsSettingsOpen}" Background="#CC0A0D14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="#121620" BorderBrush="#2D374D" BorderThickness="1" CornerRadius="12" Padding="24" Width="680" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid RowDefinitions="Auto, *, Auto">
                    <Border Grid.Row="0" Background="#161B26" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <!-- Native Vector Icon in Modal Header -->
                            <Viewbox Grid.Column="0" Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Canvas Width="48" Height="48">
                                    <Ellipse Canvas.Left="2" Canvas.Top="2" Width="44" Height="44" Stroke="#3E7BFA" StrokeThickness="3.5" Fill="#121620"/>
                                    <Rectangle Canvas.Left="12" Canvas.Top="14" Width="24" Height="20" RadiusX="6" RadiusY="6" Fill="#1E2B45" Stroke="#00E599" StrokeThickness="1.5"/>
                                    <Rectangle Canvas.Left="16" Canvas.Top="21" Width="4" Height="6" Fill="#BAC2DE"/>
                                    <Rectangle Canvas.Left="15" Canvas.Top="22" Width="6" Height="4" Fill="#BAC2DE"/>
                                    <Ellipse Canvas.Left="28" Canvas.Top="20" Width="3" Height="3" Fill="#FF4D6D"/>
                                    <Ellipse Canvas.Left="26" Canvas.Top="23" Width="3" Height="3" Fill="#3E7BFA"/>
                                    <Ellipse Canvas.Left="30" Canvas.Top="23" Width="3" Height="3" Fill="#00E599"/>
                                    <Ellipse Canvas.Left="28" Canvas.Top="26" Width="3" Height="3" Fill="#FFB900"/>
                                </Canvas>
                            </Viewbox>

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="⚙️ Application Settings &amp; Updates" FontWeight="Bold" FontSize="16" Foreground="White"/>
                                <TextBlock Text="Configure startup preferences, system tray behavior, and app updates." Foreground="#8B95A5" FontSize="11"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="✕" Command="{Binding CloseSettingsCommand}" Width="32" Height="32" CornerRadius="6" Background="#262D3D" Foreground="White"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" MaxHeight="420">
                        <StackPanel Spacing="14">
                            <Border Background="#161B26" CornerRadius="8" Padding="14" BorderBrush="#20283C" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="System Integration &amp; Tray Behavior" FontWeight="Bold" FontSize="13" Foreground="#BAC2DE"/>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Run on Windows Startup" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                                            <TextBlock Text="Starts ECCR in the background when your computer boots up." FontSize="11" Foreground="#888899"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartWithWindows}" OnContent="Enabled" OffContent="Disabled"/>
                                    </Grid>
                                    <Border Height="1" Background="#1F283C" Margin="0,2"/>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Run in System Tray" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                                            <TextBlock Text="Keep ECCR active in the taskbar notification area." FontSize="11" Foreground="#888899"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding RunInSystemTray}" OnContent="Enabled" OffContent="Disabled"/>
                                    </Grid>
                                    <Border Height="1" Background="#1F283C" Margin="0,2"/>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Minimize to System Tray" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                                            <TextBlock Text="Hides the main window to the notification area when minimized." FontSize="11" Foreground="#888899"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTray}" OnContent="Enabled" OffContent="Disabled"/>
                                    </Grid>
                                    <Border Height="1" Background="#1F283C" Margin="0,2"/>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Closing Window Minimizes to Tray" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                                            <TextBlock Text="Clicking the 'X' button hides ECCR to tray instead of quitting." FontSize="11" Foreground="#888899"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CloseMinimizesToTray}" OnContent="Enabled" OffContent="Disabled"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="#161B26" CornerRadius="8" Padding="14" BorderBrush="#20283C" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Software Updates (Velopack)" FontWeight="Bold" FontSize="13" Foreground="#BAC2DE"/>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Check for Updates on Startup" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                                            <TextBlock Text="Automatically look for newer versions when ECCR starts." FontSize="11" Foreground="#888899"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoCheckForUpdates}" OnContent="Enabled" OffContent="Disabled"/>
                                    </Grid>
                                    <Border Background="#10141E" CornerRadius="6" Padding="12" Margin="0,4,0,0" BorderBrush="#1F283C" BorderThickness="1">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock Text="{Binding UpdateStatusText}" FontWeight="SemiBold" FontSize="12" Foreground="#D0D0E0"/>
                                                <ProgressBar IsVisible="{Binding IsInstallingUpdate}" Value="{Binding UpdateDownloadProgress}" Maximum="100" Height="6" CornerRadius="3"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0">
                                                <Button Content="🔄 Check Now" Command="{Binding CheckForUpdatesManualCommand}" IsEnabled="{Binding !IsCheckingForUpdates}" Background="#1F283C" Foreground="White" FontSize="11" Padding="10,6" CornerRadius="5"/>
                                                <Button Content="⬇ Install &amp; Restart" Command="{Binding InstallUpdateAndRestartCommand}" IsVisible="{Binding IsUpdateAvailable}" IsEnabled="{Binding !IsInstallingUpdate}" Background="#00B074" Foreground="White" FontWeight="Bold" FontSize="11" Padding="12,6" CornerRadius="5"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Button Content="Done &amp; Save Preferences" Command="{Binding CloseSettingsCommand}" HorizontalAlignment="Right" Background="#00B074" Foreground="White" FontWeight="SemiBold" Padding="20,8" CornerRadius="6"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- HIDHIDE MODAL -->
        <Border IsVisible="{Binding IsHidHideMenuOpen}" Background="#CC0A0D14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="#121620" BorderBrush="#2D374D" BorderThickness="1" CornerRadius="12" Padding="22" Width="920" Height="600" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid RowDefinitions="Auto, *, Auto">
                    <Border Grid.Row="0" Background="#161B26" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*, Auto, Auto">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="🛡️ HidHide Device Cloaking &amp; Application Rules" FontWeight="Bold" FontSize="16" Foreground="White"/>
                                <TextBlock Text="Hide physical hardware to eliminate double inputs. Whitelist games like Assetto Corsa to bypass cloaking." Foreground="#8B95A5" FontSize="12"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsHidHideActive}" OnContent="Cloaking Active" OffContent="Disabled" Margin="0,0,14,0"/>
                            <Button Grid.Column="2" Content="✕" Command="{Binding CloseHidHideMenuCommand}" Width="32" Height="32" CornerRadius="6"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" ColumnDefinitions="*, 14, *">
                        <Border Grid.Column="0" Background="#161B26" CornerRadius="8" Padding="12">
                            <Grid RowDefinitions="Auto, Auto, *">
                                <TextBlock Grid.Row="0" Text="1. Physical Hardware to Cloak" FontWeight="Bold" Margin="0,0,0,8"/>
                                <Grid Grid.Row="1" ColumnDefinitions="Auto, Auto, *" Margin="0,0,0,8">
                                    <Button Grid.Column="0" Content="Cloak All" Command="{Binding SelectAllHidDevicesCommand}" Padding="10,4" FontSize="11"/>
                                    <Button Grid.Column="1" Content="Uncloak All" Command="{Binding DeselectAllHidDevicesCommand}" Margin="6,0,0,0" Padding="10,4" FontSize="11"/>
                                </Grid>
                                <ScrollViewer Grid.Row="2">
                                    <ItemsControl ItemsSource="{Binding HidDevices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="services:HidDeviceItem">
                                                <Border Background="#121620" CornerRadius="6" Padding="8" Margin="0,2">
                                                    <Grid ColumnDefinitions="*, Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding FriendlyName}" VerticalAlignment="Center"/>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsHidden}" 
                                                                  Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).ToggleHidDeviceCommand}"
                                                                  CommandParameter="{Binding}" Content="Hide"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="#161B26" CornerRadius="8" Padding="12">
                            <Grid RowDefinitions="Auto, Auto, *">
                                <TextBlock Grid.Row="0" Text="2. Whitelisted Applications" FontWeight="Bold" Margin="0,0,0,8"/>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                                    <Button Content="+ Add Game (.exe)" Command="{Binding AddApplicationToHidHideCommand}" CommandParameter="{Binding #RootWindow.StorageProvider}" FontSize="11"/>
                                    <Button Content="Clear All" Command="{Binding ClearAllApplicationsFromHidHideCommand}" FontSize="11"/>
                                </StackPanel>
                                <ScrollViewer Grid.Row="3">
                                    <ItemsControl ItemsSource="{Binding WhitelistedApplications}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Background="#121620" CornerRadius="6" Padding="6" Margin="0,2">
                                                    <Grid ColumnDefinitions="*, Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Content="✕" Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).RemoveApplicationFromHidHideCommand}" CommandParameter="{Binding}" Foreground="#FF6666" Background="Transparent"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Button Content="Apply &amp; Done" Command="{Binding CloseHidHideMenuCommand}" HorizontalAlignment="Right" Background="#00B074" FontWeight="SemiBold" Padding="20,6" CornerRadius="6"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- CREATE PROFILE MODAL -->
        <Border IsVisible="{Binding IsCreatingProfile}" Background="#CC0A0D14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="#161B26" BorderBrush="#2D374D" BorderThickness="1" CornerRadius="10" Padding="24" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="Create New Profile" FontSize="18" FontWeight="Bold"/>
                    <TextBox Text="{Binding CustomProfileInput}" Watermark="Enter profile name (e.g., Assetto Rig)" CornerRadius="6" Background="#0E1118" Padding="10,8"/>
                    <Grid ColumnDefinitions="*, *">
                        <Button Grid.Column="0" Content="Cancel" Command="{Binding CancelCreateProfileCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,6,0" Background="#262D3D" CornerRadius="6"/>
                        <Button Grid.Column="1" Content="Create &amp; Save" Command="{Binding ConfirmCreateProfileCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="6,0,0,0" FontWeight="SemiBold" Background="#00B074" CornerRadius="6"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>