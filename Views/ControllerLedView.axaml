<!-- Controller LED page: lightbar color/effect control for DualSense/DualShock 4 only. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ECCR.ViewModels"
             xmlns:models="using:ECCR.Models"
             mc:Ignorable="d"
             d:DesignWidth="800" d:DesignHeight="600"
             x:Class="ECCR.Views.ControllerLedView"
             x:DataType="vm:ControllerLedViewModel">

    <Design.DataContext>
        <vm:ControllerLedViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *" Margin="24">
        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,16">
            <Grid ColumnDefinitions="Auto, *">
                <Image Grid.Column="0" Source="avares://ECCR/Assets/UILogos/Full-LEDLogo.png" Width="22" Height="22"
                       Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                <TextBlock Grid.Column="1" Text="Controller LED" FontWeight="Bold" FontSize="18" Foreground="White" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="Set the lightbar color and animation for a connected PlayStation controller." FontSize="12" Foreground="#8B95A5"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
        <StackPanel Spacing="14" MaxWidth="520" HorizontalAlignment="Center">
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Device" FontWeight="SemiBold" FontSize="12" Foreground="#BAC2DE"/>
                    <ComboBox ItemsSource="{Binding GamepadDevices}"
                              SelectedItem="{Binding SelectedDevice}"
                              HorizontalAlignment="Stretch"
                              Background="#10141E"
                              CornerRadius="6">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ControllerStatus">
                                <TextBlock Text="{Binding DeviceInstanceName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Not supported for this device." Foreground="#FFAAAA" FontSize="12" IsVisible="{Binding !IsSupportedForSelectedDevice}"/>
                </StackPanel>
            </Border>

            <Border Classes="card" IsEnabled="{Binding IsSupportedForSelectedDevice}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Lightbar Color" FontWeight="SemiBold" FontSize="12" Foreground="#BAC2DE"/>

                    <Border Height="48" CornerRadius="8" Background="{Binding PreviewBrush}"/>

                    <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto, Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="R" Foreground="#FF7088" Width="16"/>
                        <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Red}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Red}" Width="32" HorizontalAlignment="Right" Foreground="#8B95A5"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="G" Foreground="#5CFFBE" Width="16" Margin="0,8,0,0"/>
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Green}" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Green}" Width="32" HorizontalAlignment="Right" Foreground="#8B95A5" Margin="0,8,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="B" Foreground="#70A0FF" Width="16" Margin="0,8,0,0"/>
                        <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Blue}" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Blue}" Width="32" HorizontalAlignment="Right" Foreground="#8B95A5" Margin="0,8,0,0"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <TextBlock Grid.Column="0" Text="Hex" Foreground="#BAC2DE" Width="32" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding HexInput}" Watermark="#RRGGBB" MaxLength="7"
                                  Background="#10141E" CornerRadius="6">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding ApplyHexInputCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="2" Content="Set" Command="{Binding ApplyHexInputCommand}" Classes="neutral" Margin="6,0,0,0"/>
                    </Grid>

                    <Button Content="Apply Color" Command="{Binding ApplyColorCommand}" Classes="primary" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#8B95A5"/>
                </StackPanel>
            </Border>

            <Border Classes="card" IsEnabled="{Binding IsSupportedForSelectedDevice}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Lightbar Mode" FontWeight="SemiBold" FontSize="12" Foreground="#BAC2DE"/>

                    <ComboBox ItemsSource="{Binding EffectModes}" SelectedItem="{Binding EffectMode}"
                              HorizontalAlignment="Stretch" Background="#10141E" CornerRadius="6"/>

                    <StackPanel Spacing="6" IsVisible="{Binding IsEffectModeActive}">
                        <TextBlock Text="Speed" Foreground="#8B95A5" FontSize="11"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <Slider Grid.Column="0" Minimum="0.2" Maximum="3.0" Value="{Binding EffectSpeed}"/>
                            <TextBlock Grid.Column="1" Text="{Binding EffectSpeed, StringFormat={}{0:0.0}x}" Width="40" HorizontalAlignment="Right" Foreground="#8B95A5"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
