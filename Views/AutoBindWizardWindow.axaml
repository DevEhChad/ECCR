<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ECCR.ViewModels"
        xmlns:services="using:ECCR.Services"
        xmlns:converters="using:ECCR.Converters"
        x:DataType="vm:MainWindowViewModel"
        x:Class="ECCR.Views.AutoBindWizardWindow"
        x:Name="WizardRootWindow"
        Width="780" Height="620"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#10141E"
        Foreground="White"
        Title="Auto-Detect &amp; Xbox Quick-Bind Wizard">

    <Border Padding="22">
        <Grid RowDefinitions="Auto, Auto, *, Auto">
            
            <StackPanel Grid.Row="0" Spacing="3" Margin="0,0,0,14">
                <TextBlock Text="⚡ Auto-Detect &amp; Xbox Face Button Setup" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Select a connected device to automatically map physical face keys, paddles, and axes directly to Xbox navigation controls." 
                           Foreground="#8B95A5" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="1" Background="#161B26" CornerRadius="8" Padding="14,10" Margin="0,0,0,14" BorderBrush="#252F44" BorderThickness="1">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <TextBlock Grid.Column="0" Text="Detected Hardware:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0" Foreground="#BAC2DE"/>
                    
                    <ComboBox Grid.Column="1" 
                              ItemsSource="{Binding ConnectedDevices}"
                              SelectedItem="{Binding WizardSelectedDevice}"
                              HorizontalAlignment="Stretch" 
                              CornerRadius="6" 
                              Background="#10141E" 
                              BorderBrush="#2F384C"/>

                    <Button Grid.Column="2" 
                            Content="⚡ Auto-Fill Preset" 
                            Command="{Binding PopulateWizardPresetCommand}"
                            Background="#3E7BFA" 
                            Foreground="White" 
                            FontWeight="SemiBold" 
                            Margin="10,0,0,0" 
                            Padding="14,6" 
                            CornerRadius="6"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="#161B26" CornerRadius="8" Padding="12" BorderBrush="#252F44" BorderThickness="1">
                <Grid RowDefinitions="Auto, *">
                    <Grid Grid.Row="0" ColumnDefinitions="1.5*, 1.8*, 1.2*" Margin="6,0,6,8">
                        <TextBlock Grid.Column="0" Text="Physical Hardware Button / Axis" FontWeight="Bold" FontSize="12" Foreground="#8B95A5"/>
                        <TextBlock Grid.Column="1" Text="Mapped Output Channel" FontWeight="Bold" FontSize="12" Foreground="#8B95A5"/>
                        <TextBlock Grid.Column="2" Text="Function / Role" FontWeight="Bold" FontSize="12" Foreground="#8B95A5"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding WizardBindings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:PresetBindingItem">
                                    <Border Background="#10141E" CornerRadius="6" Padding="10,8" Margin="0,2" BorderBrush="#1F283C" BorderThickness="1">
                                        <Grid ColumnDefinitions="1.5*, 1.8*, 1.2*">
                                            
                                            <!-- Physical Name with Badge -->
                                            <Grid Grid.Column="0" ColumnDefinitions="Auto, *" VerticalAlignment="Center">
                                                <Border Grid.Column="0" 
                                                        x:DataType="converters:BadgeInfo"
                                                        DataContext="{Binding $parent[Border].((services:PresetBindingItem)DataContext).PhysicalName, Converter={StaticResource ButtonBadgeConverter}}"
                                                        IsVisible="{Binding HasBadge}"
                                                        Background="{Binding Background}"
                                                        BorderBrush="{Binding Border}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Width="20" Height="20"
                                                        Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Glyph}" 
                                                               Foreground="{Binding Foreground}"
                                                               FontSize="11" 
                                                               FontWeight="Bold" 
                                                               HorizontalAlignment="Center" 
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding PhysicalName}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                            </Grid>
                                            
                                            <!-- Output Dropdown with Badges -->
                                            <ComboBox Grid.Column="1" 
                                                      ItemsSource="{Binding #WizardRootWindow.((vm:MainWindowViewModel)DataContext).AvailableVirtualOutputs}"
                                                      SelectedItem="{Binding DefaultTargetOutput}"
                                                      HorizontalAlignment="Stretch"
                                                      Margin="4,0"
                                                      Background="#161B26"
                                                      CornerRadius="5"
                                                      FontSize="12">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Grid ColumnDefinitions="Auto, *">
                                                            <Border Grid.Column="0" 
                                                                    x:DataType="converters:BadgeInfo"
                                                                    DataContext="{Binding Converter={StaticResource ButtonBadgeConverter}}"
                                                                    IsVisible="{Binding HasBadge}"
                                                                    Background="{Binding Background}"
                                                                    BorderBrush="{Binding Border}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="10"
                                                                    Width="18" Height="18"
                                                                    Margin="0,0,6,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Glyph}" 
                                                                           Foreground="{Binding Foreground}"
                                                                           FontSize="10" 
                                                                           FontWeight="Bold" 
                                                                           HorizontalAlignment="Center" 
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <TextBlock Grid.Column="2" Text="{Binding Description}" Foreground="#00E599" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Row="3" ColumnDefinitions="Auto, *" Margin="0,14,0,0">
                <Button Grid.Column="0" Content="Cancel" Click="OnCancelClicked" 
                        Background="#262D3D" Foreground="White" Padding="18,6" CornerRadius="6"/>
                
                <Button Grid.Column="1" Content="✓ Apply &amp; Add to Profile" Command="{Binding ApplyWizardBindingsCommand}" 
                        Click="OnCancelClicked"
                        HorizontalAlignment="Right" Background="#00B074" Foreground="White" FontWeight="Bold" Padding="24,6" CornerRadius="6"/>
            </Grid>
        </Grid>
    </Border>
</Window>