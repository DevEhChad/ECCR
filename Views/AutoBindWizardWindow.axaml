<!--
    Auto-Bind Wizard: DataContext is AutoBindWizardViewModel (not MainWindowViewModel), set
    directly by ECCR.ViewModels.AutoBindWizardViewModel.OpenAutoBindWizard. Lets the user
    pick a connected device, previews the full preset DevicePresetService.GeneratePreset
    would generate for it, then applies it in one shot (replacing any existing mappings for
    that device).
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ECCR.ViewModels"
        xmlns:models="using:ECCR.Models"
        xmlns:services="using:ECCR.Services"
        xmlns:converters="using:ECCR.Converters"
        x:Class="ECCR.Views.AutoBindWizardWindow"
        x:DataType="vm:AutoBindWizardViewModel"
        Title="Auto-Bind Wizard"
        Width="650" Height="580"
        WindowStartupLocation="CenterOwner"
        Background="#0E1118"
        Foreground="White"
        CanResize="false">

    <Window.Resources>
        <converters:ButtonBadgeConverter x:Key="ButtonBadgeConverter"/>
    </Window.Resources>

    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="20">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="⚡ Auto-Bind Configuration Wizard" FontWeight="Bold" FontSize="18" Foreground="White"/>
            <TextBlock Text="Quickly generate standard button and axis mappings for your selected controller or wheel rig." FontSize="12" Foreground="#8B95A5"/>
        </StackPanel>

        <!-- Device Selector & Target Mode -->
        <Border Grid.Row="1" Background="#161B26" CornerRadius="8" Padding="14" Margin="0,0,0,14" BorderBrush="#20283C" BorderThickness="1">
            <Grid ColumnDefinitions="*, 14, Auto">
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="Selected Controller / Device" FontWeight="SemiBold" FontSize="12" Foreground="#BAC2DE"/>
                    <ComboBox ItemsSource="{Binding ConnectedDevices}"
                              SelectedItem="{Binding WizardSelectedDevice}"
                              HorizontalAlignment="Stretch"
                              Background="#10141E"
                              CornerRadius="6"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Emulation Profile Target" FontWeight="SemiBold" FontSize="12" Foreground="#BAC2DE"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <RadioButton Content="DirectInput Wheel" IsChecked="{Binding WizardTargetIsWheel}" GroupName="TargetType" Foreground="White"/>
                        <RadioButton Content="Xbox Gamepad" IsChecked="{Binding !WizardTargetIsWheel}" GroupName="TargetType" Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Mappings Preview List -->
        <Border Grid.Row="2" Background="#161B26" CornerRadius="8" Padding="12" BorderBrush="#20283C" BorderThickness="1">
            <Grid RowDefinitions="Auto, *">
                <Grid Grid.Row="0" ColumnDefinitions="2*, 1*, 2.5*" Margin="8,0,8,8">
                    <TextBlock Grid.Column="0" Text="Physical Input" FontWeight="Bold" FontSize="12" Foreground="#8B95A5"/>
                    <TextBlock Grid.Column="1" Text="Type" FontWeight="Bold" FontSize="12" Foreground="#8B95A5"/>
                    <TextBlock Grid.Column="2" Text="Mapped Output" FontWeight="Bold" FontSize="12" Foreground="#8B95A5"/>
                </Grid>

                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding WizardBindings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PresetBindingItem">
                                <Border Background="#10141E" CornerRadius="6" Padding="10,8" Margin="0,3">
                                    <Grid ColumnDefinitions="2*, 1*, 2.5*">
                                        <TextBlock Grid.Column="0" Text="{Binding PhysicalName}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Type}" VerticalAlignment="Center" Foreground="#8B95A5" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DefaultTargetOutput}" VerticalAlignment="Center" Foreground="#00E599" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Footer Buttons -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto, *, Auto, Auto" Margin="0,16,0,0">
            <Button Grid.Column="0" Content="🔄 Regenerate Preset" Command="{Binding PopulateWizardPresetCommand}" Background="#1F283C" Foreground="White" Padding="14,8" CornerRadius="6"/>
            <Button Grid.Column="2" Content="Cancel" Click="OnCancelClick" Background="#262D3D" Foreground="White" Padding="16,8" CornerRadius="6" Margin="0,0,10,0"/>
            <Button Grid.Column="3" Content="Apply Configuration" Command="{Binding ApplyWizardBindingsCommand}" Click="OnApplyClick" Background="#00B074" Foreground="White" FontWeight="Bold" Padding="18,8" CornerRadius="6"/>
        </Grid>
    </Grid>
</Window>