<!--
    Controller Mapping page: DSX-style redesign. Header carries the profile switcher (lifted
    from ProfilesView's forwarding pattern) and a static Virtual Device indicator, then a
    device picker scoping the Deadzones/Sticks/More Options tabs, then a tab strip switching
    between Button Mapping (today's collapsible per-device grid, via the shared
    DeviceMappingGroupsPanel - unaffected by the device picker, since it's explicitly meant to
    stay "all binds, all devices"), Deadzones, Sticks, Motion (placeholder), Touchpad
    (placeholder), and More Options. See ControllerMappingViewModel for the tab/device-selection
    state; row-level commands inside DeviceMappingGroupsPanel still reach MainWindowViewModel
    via its own "$parent[Window].((vm:MainWindowViewModel)DataContext).X" path, unchanged.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ECCR.ViewModels"
             xmlns:models="using:ECCR.Models"
             xmlns:shared="using:ECCR.Views.Shared"
             mc:Ignorable="d"
             d:DesignWidth="1100" d:DesignHeight="760"
             x:Class="ECCR.Views.ControllerMappingView"
             x:DataType="vm:ControllerMappingViewModel">

    <Design.DataContext>
        <vm:ControllerMappingViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, *" Margin="16,10">
        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,10">
            <TextBlock Text="🎮 Controller Mapping" FontWeight="Bold" FontSize="18" Foreground="White"/>
            <TextBlock Text="Bind buttons and axes for gamepad-class controllers (PlayStation, Xbox, Nintendo, generic pads)." FontSize="12" Foreground="#8B95A5"/>
            <Border Background="#161B26" BorderBrush="#2B354C" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,6,0,0">
                <TextBlock FontSize="11" Foreground="#8B95A5" TextWrapping="Wrap">
                    <Run Text="💡" />
                    <Run Text="Click any binding, then press a button or move an axis to capture it - you have 7 seconds. "/>
                    <Run Text="Esc" FontWeight="Bold" Foreground="#D0D0E0"/>
                    <Run Text=" cancels, "/>
                    <Run Text="Backspace" FontWeight="Bold" Foreground="#D0D0E0"/>
                    <Run Text=" clears the binding."/>
                </TextBlock>
            </Border>
        </StackPanel>

        <!-- Profile switcher + Virtual Device indicator -->
        <Grid Grid.Row="1" ColumnDefinitions="*, 14, Auto" Margin="0,0,0,10">
            <Border Grid.Column="0" Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="Edit Controller Profile" FontWeight="SemiBold" FontSize="12" Foreground="#BAC2DE"/>
                    <Grid ColumnDefinitions="*, Auto, Auto, Auto">
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding Profiles}"
                                  SelectedItem="{Binding SelectedProfile}"
                                  HorizontalAlignment="Stretch"
                                  CornerRadius="6"
                                  Background="#10141E"/>
                        <Button Grid.Column="1" Content="+ New" Command="{Binding OpenCreateProfileDialogCommand}"
                                Margin="8,0,0,0" Padding="10,8" CornerRadius="6" Background="#232A3B" BorderBrush="#3D4B6E"/>
                        <Button Grid.Column="2" Content="Save" Command="{Binding SaveCurrentProfileCommand}"
                                Margin="6,0,0,0" Padding="10,8" CornerRadius="6" FontWeight="SemiBold" Background="#1A4A38" BorderBrush="#266D53"/>
                        <Button Grid.Column="3" Content="🗑" Command="{Binding DeleteCurrentProfileCommand}"
                                Margin="6,0,0,0" Padding="10,8" CornerRadius="6" Background="#2A1B1F" BorderBrush="#552229" Foreground="#FFAAAA"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="Virtual Device" FontWeight="SemiBold" FontSize="12" Foreground="#BAC2DE"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Background="#122A1E" BorderBrush="#00E599" BorderThickness="1" CornerRadius="6" Padding="10,6"
                                ToolTip.Tip="Pick per-binding via each row's Channel dropdown - [Xbox] targets route here.">
                            <TextBlock Text="🎮 Xbox 360 (ViGEm)" FontSize="11" FontWeight="SemiBold" Foreground="#5CFFBE"/>
                        </Border>
                        <Border Background="#122A1E" BorderBrush="#00E599" BorderThickness="1" CornerRadius="6" Padding="10,6"
                                ToolTip.Tip="Pick per-binding via each row's Channel dropdown - [DS4] targets route here.">
                            <TextBlock Text="🎮 DualShock 4 (ViGEm)" FontSize="11" FontWeight="SemiBold" Foreground="#5CFFBE"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Device picker: scopes the Deadzones / Sticks / More Options tabs -->
        <Border Grid.Row="2" Classes="card" Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto, *">
                <TextBlock Grid.Column="0" Text="Device" FontWeight="SemiBold" FontSize="12" Foreground="#BAC2DE" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding GroupEntries}"
                          SelectedValue="{Binding SelectedDeviceName}"
                          SelectedValueBinding="{Binding DeviceName}"
                          HorizontalAlignment="Stretch"
                          CornerRadius="6"
                          Background="#10141E">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:DeviceMappingGroup">
                            <TextBlock Text="{Binding DeviceName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </Border>

        <!-- Tab strip -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Classes="mappingTab" Classes.mappingTabSelected="{Binding IsButtonMappingTabSelected}"
                    Command="{Binding SelectTabCommand}" CommandParameter="{x:Static models:MappingTab.ButtonMapping}"
                    Content="Button Mapping"/>
            <Button Classes="mappingTab" Classes.mappingTabSelected="{Binding IsDeadzonesTabSelected}"
                    Command="{Binding SelectTabCommand}" CommandParameter="{x:Static models:MappingTab.Deadzones}"
                    Content="Deadzones"/>
            <Button Classes="mappingTab" Classes.mappingTabSelected="{Binding IsMotionTabSelected}"
                    Command="{Binding SelectTabCommand}" CommandParameter="{x:Static models:MappingTab.Motion}"
                    Content="Motion"/>
            <Button Classes="mappingTab" Classes.mappingTabSelected="{Binding IsSticksTabSelected}"
                    Command="{Binding SelectTabCommand}" CommandParameter="{x:Static models:MappingTab.Sticks}"
                    Content="Sticks"/>
            <Button Classes="mappingTab" Classes.mappingTabSelected="{Binding IsTouchpadTabSelected}"
                    Command="{Binding SelectTabCommand}" CommandParameter="{x:Static models:MappingTab.Touchpad}"
                    Content="Touchpad"/>
            <Button Classes="mappingTab" Classes.mappingTabSelected="{Binding IsMoreOptionsTabSelected}"
                    Command="{Binding SelectTabCommand}" CommandParameter="{x:Static models:MappingTab.MoreOptions}"
                    Content="More Options"/>
        </StackPanel>

        <!-- Tab content -->
        <Panel Grid.Row="4">

            <!-- Button Mapping: today's full grouped list across all devices, unaffected by
                 the device picker above - this is the "controller mappings drop down" that
                 must stay available for all keybinds regardless of which device is selected. -->
            <Grid RowDefinitions="Auto, Auto, *" IsVisible="{Binding IsButtonMappingTabSelected}">
                <Button Grid.Row="0" Content="+ New Binding" HorizontalAlignment="Right" Margin="0,0,0,8"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AddGamepadMappingCommand}"
                        Background="#1A4A38" BorderBrush="#266D53" Foreground="White" FontWeight="SemiBold" Padding="12,7" CornerRadius="6"
                        ToolTip.Tip="Adds a new unbound row - click it, then press a button or move an axis to bind it."/>
                <Grid Grid.Row="1" ColumnDefinitions="32, 1.8*, 0.9*, 1.4*, 1.8*, 1.4*, 1*, 36" Margin="14,0,14,8">
                    <Border Grid.ColumnSpan="8" BorderThickness="0,0,0,2" BorderBrush="#262D3D" Padding="0,0,0,6"/>
                    <TextBlock Grid.Column="0" Text="Select" FontSize="11" FontWeight="SemiBold" Foreground="#8B95A5" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="Physical Key / Axis" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="Type" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="3" Text="Virtual Player Slot" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="4" Text="Channel" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="5" Text="Dead Zone" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="6" Text="Calibration" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <shared:DeviceMappingGroupsPanel Grid.Row="2" ItemsSource="{Binding GroupEntries}" DeviceIconGlyph="🎮"/>
            </Grid>

            <!-- Deadzones: axis rows for the selected device only, same Deadzone/RawMin/RawMax
                 data as the Button Mapping tab, just with more room per row. -->
            <ScrollViewer IsVisible="{Binding IsDeadzonesTabSelected}">
                <StackPanel Spacing="10">
                    <TextBlock Text="No axis inputs bound for this device yet." Foreground="#8B95A5" FontSize="12"
                               IsVisible="{Binding !HasAxisEntries}" Margin="4,8"/>
                    <ItemsControl ItemsSource="{Binding AxisEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:MappingEntry">
                                <Border Classes="card" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="1.4*, *, Auto" RowDefinitions="Auto, Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding SourceDisplayName}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding TargetOutput}" FontSize="11" Foreground="#8B95A5" Margin="0,2,0,0"/>

                                        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" ColumnDefinitions="*, 44" VerticalAlignment="Center" Margin="12,0">
                                            <Slider Grid.Column="0" Minimum="0.0" Maximum="0.5" Value="{Binding Deadzone}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Deadzone, StringFormat='{}{0:P0}'}" FontSize="11" Foreground="#8B95A5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                                                Content="Calibrate"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenCalibrationCommand}"
                                                CommandParameter="{Binding}"
                                                Background="#1B2130" BorderBrush="#2B354C" CornerRadius="6" Padding="12,8" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Sticks: axis rows grouped by physical stick, each with an Invert toggle. -->
            <ScrollViewer IsVisible="{Binding IsSticksTabSelected}">
                <StackPanel Spacing="16">
                    <TextBlock Text="No axis inputs bound for this device yet." Foreground="#8B95A5" FontSize="12"
                               IsVisible="{Binding !HasAxisEntries}" Margin="4,8"/>

                    <StackPanel Spacing="8" IsVisible="{Binding HasLeftStickAxes}">
                        <TextBlock Text="Left Stick" FontWeight="SemiBold" FontSize="13" Foreground="#BAC2DE"/>
                        <ItemsControl ItemsSource="{Binding LeftStickAxes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:MappingEntry">
                                    <Border Classes="card" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding SourceDisplayName}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="Invert" FontSize="11" Foreground="#8B95A5" VerticalAlignment="Center"/>
                                                <ToggleSwitch IsChecked="{Binding IsInverted}" OnContent="" OffContent=""/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="8" IsVisible="{Binding HasRightStickAxes}">
                        <TextBlock Text="Right Stick" FontWeight="SemiBold" FontSize="13" Foreground="#BAC2DE"/>
                        <ItemsControl ItemsSource="{Binding RightStickAxes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:MappingEntry">
                                    <Border Classes="card" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding SourceDisplayName}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="Invert" FontSize="11" Foreground="#8B95A5" VerticalAlignment="Center"/>
                                                <ToggleSwitch IsChecked="{Binding IsInverted}" OnContent="" OffContent=""/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="8" IsVisible="{Binding HasOtherAxes}">
                        <TextBlock Text="Other Axes" FontWeight="SemiBold" FontSize="13" Foreground="#BAC2DE"/>
                        <ItemsControl ItemsSource="{Binding OtherAxes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:MappingEntry">
                                    <Border Classes="card" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding SourceDisplayName}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="Invert" FontSize="11" Foreground="#8B95A5" VerticalAlignment="Center"/>
                                                <ToggleSwitch IsChecked="{Binding IsInverted}" OnContent="" OffContent=""/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Motion: live gyro readout + Gyro-Aim toggle (feeds Right Stick of a chosen
                 Player's virtual Xbox 360 pad - see ControllerMappingViewModel /
                 MainWindowViewModel.ApplyMotionAndTouchAim). PlayStation devices only. -->
            <StackPanel IsVisible="{Binding IsMotionTabSelected}" Spacing="10" VerticalAlignment="Top">
                <Border Classes="card" IsVisible="{Binding !IsMotionSupportedForSelectedDevice}">
                    <TextBlock Text="Motion is not supported for this device (PlayStation controllers only)." Foreground="#FFAAAA" FontSize="13"/>
                </Border>

                <Border Classes="card" IsVisible="{Binding IsMotionSupportedForSelectedDevice}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Live Gyro Reading" FontWeight="SemiBold" FontSize="12" Foreground="#BAC2DE"/>
                        <Grid ColumnDefinitions="54,*,50" RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Pitch" Foreground="#8B95A5" FontSize="11" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Row="0" Grid.Column="1" Minimum="-1" Maximum="1" Value="{Binding SelectedDeviceStatus.GyroPitch}" Margin="8,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SelectedDeviceStatus.GyroPitch, StringFormat={}{0:0.00}}" FontSize="11" Foreground="#8B95A5" HorizontalAlignment="Right"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Yaw" Foreground="#8B95A5" FontSize="11" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <ProgressBar Grid.Row="1" Grid.Column="1" Minimum="-1" Maximum="1" Value="{Binding SelectedDeviceStatus.GyroYaw}" Margin="8,8,8,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SelectedDeviceStatus.GyroYaw, StringFormat={}{0:0.00}}" FontSize="11" Foreground="#8B95A5" HorizontalAlignment="Right" Margin="0,8,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Roll" Foreground="#8B95A5" FontSize="11" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <ProgressBar Grid.Row="2" Grid.Column="1" Minimum="-1" Maximum="1" Value="{Binding SelectedDeviceStatus.GyroRoll}" Margin="8,8,8,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SelectedDeviceStatus.GyroRoll, StringFormat={}{0:0.00}}" FontSize="11" Foreground="#8B95A5" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card" IsVisible="{Binding IsMotionSupportedForSelectedDevice}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Gyro Aim" FontWeight="SemiBold" FontSize="12" Foreground="#BAC2DE"/>
                        <TextBlock Text="Maps this device's gyro yaw/pitch straight to the Right Stick of the chosen player's virtual Xbox 360 controller." FontSize="11" Foreground="#8B95A5" TextWrapping="Wrap"/>
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <ToggleSwitch Grid.Column="0" IsChecked="{Binding IsGyroAimEnabledForSelectedDevice}" OnContent="Enabled" OffContent="Disabled"/>
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{x:Static vm:MainWindowViewModel.PlayerTargets}"
                                      SelectedValue="{Binding GyroAimTargetPlayer}"
                                      SelectedValueBinding="{Binding Id}"
                                      Width="170" CornerRadius="6" Background="#10141E">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:PlayerTargetOption">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="11"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Touchpad: live touch X/Y readout + Touch-Aim toggle (same Right Stick target
                 pattern as Gyro Aim above). PlayStation devices only; digital "Touchpad Click"
                 remains bindable as an ordinary button on the Button Mapping tab. -->
            <StackPanel IsVisible="{Binding IsTouchpadTabSelected}" Spacing="10" VerticalAlignment="Top">
                <Border Classes="card" IsVisible="{Binding !IsMotionSupportedForSelectedDevice}">
                    <TextBlock Text="Touchpad is not supported for this device (PlayStation controllers only)." Foreground="#FFAAAA" FontSize="13"/>
                </Border>

                <Border Classes="card" IsVisible="{Binding IsMotionSupportedForSelectedDevice}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Live Touch Reading" FontWeight="SemiBold" FontSize="12" Foreground="#BAC2DE"/>
                        <Grid ColumnDefinitions="54,*,50" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="X" Foreground="#8B95A5" FontSize="11" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding SelectedDeviceStatus.TouchX}" Margin="8,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SelectedDeviceStatus.TouchX, StringFormat={}{0:0.00}}" FontSize="11" Foreground="#8B95A5" HorizontalAlignment="Right"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Y" Foreground="#8B95A5" FontSize="11" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <ProgressBar Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding SelectedDeviceStatus.TouchY}" Margin="8,8,8,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SelectedDeviceStatus.TouchY, StringFormat={}{0:0.00}}" FontSize="11" Foreground="#8B95A5" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Finger down:" FontSize="11" Foreground="#8B95A5"/>
                            <TextBlock Text="{Binding SelectedDeviceStatus.TouchActive}" FontSize="11" Foreground="#D0D0E0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card" IsVisible="{Binding IsMotionSupportedForSelectedDevice}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Touch Aim" FontWeight="SemiBold" FontSize="12" Foreground="#BAC2DE"/>
                        <TextBlock Text="Maps finger position on the touchpad straight to the Right Stick of the chosen player's virtual Xbox 360 controller while touching." FontSize="11" Foreground="#8B95A5" TextWrapping="Wrap"/>
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <ToggleSwitch Grid.Column="0" IsChecked="{Binding IsTouchAimEnabledForSelectedDevice}" OnContent="Enabled" OffContent="Disabled"/>
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{x:Static vm:MainWindowViewModel.PlayerTargets}"
                                      SelectedValue="{Binding TouchAimTargetPlayer}"
                                      SelectedValueBinding="{Binding Id}"
                                      Width="170" CornerRadius="6" Background="#10141E">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:PlayerTargetOption">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="11"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- More Options -->
            <StackPanel IsVisible="{Binding IsMoreOptionsTabSelected}" Spacing="10" VerticalAlignment="Top">
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Lighting" FontWeight="SemiBold" FontSize="12" Foreground="#BAC2DE"/>
                        <Button Content="💡 Open Controller LED" Command="{Binding NavigateToCommand}" CommandParameter="{x:Static models:AppPage.ControllerLed}"
                                Background="#1F283C" BorderBrush="#3D4B6E" Foreground="White" Padding="12,8" CornerRadius="6" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Connection" FontWeight="SemiBold" FontSize="12" Foreground="#BAC2DE"/>
                        <TextBlock Text="No status data for this device." Foreground="#8B95A5" FontSize="12" IsVisible="{Binding !HasSelectedDeviceStatus}"/>
                        <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding HasSelectedDeviceStatus}">
                            <TextBlock Text="{Binding SelectedDeviceStatus.ConnectionType, StringFormat='Connection: {0}'}" FontSize="12" Foreground="#D0D0E0"/>
                            <TextBlock Text="{Binding SelectedDeviceStatus.BatteryPercent, StringFormat='Battery: {0}%'}" FontSize="12" Foreground="#D0D0E0" IsVisible="{Binding SelectedDeviceStatus.IsBatterySupported}"/>
                            <TextBlock Text="Charging" FontSize="12" Foreground="#5CFFBE" IsVisible="{Binding SelectedDeviceStatus.IsCharging}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Panel>
    </Grid>
</UserControl>
