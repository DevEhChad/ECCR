<!--
    Shared per-device binding grid: extracted from what used to be identical XAML duplicated
    across ControllerMappingView and DeviceMappingView. Hosts bind ItemsSource to their own
    filtered DeviceMappingGroup collection and DeviceIconGlyph to a short badge glyph; every
    row-level command still reaches MainWindowViewModel via the "$parent[Window].((vm:
    MainWindowViewModel)DataContext).X" compiled-binding path unchanged. Top-level bindings use
    ElementName syntax against this control's own styled properties (not DataContext).
    Compiled bindings stay ON for the whole file (x:DataType is the common ViewModelBase,
    since the real inherited DataContext differs by host page but nothing here binds off it
    directly) - the "$parent[Window].((vm:X)DataContext)" cast syntax used deep in the row
    templates requires compiled bindings and has no classic-binding fallback, so disabling
    them for this scope would throw at runtime even though it still compiles.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ECCR.ViewModels"
             xmlns:models="using:ECCR.Models"
             xmlns:converters="using:ECCR.Converters"
             x:Class="ECCR.Views.Shared.DeviceMappingGroupsPanel"
             x:Name="PanelRoot"
             x:DataType="vm:ViewModelBase">

    <UserControl.Resources>
        <converters:ButtonBadgeConverter x:Key="ButtonBadgeConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Grid.mappingRow:pointerover">
            <Setter Property="Background" Value="#161C2A"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *">
        <TextBox Grid.Row="0"
                 Text="{Binding #PanelRoot.SearchText}"
                 Watermark="Search binds by device, input, or target…"
                 Margin="0,0,0,8"
                 Padding="10,7"
                 CornerRadius="6"
                 Background="#121622"
                 BorderBrush="#20283C"
                 FontSize="12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
        <ItemsControl ItemsSource="{Binding #PanelRoot.FilteredGroups}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:DeviceMappingGroup">
                    <Border Background="#121622" BorderBrush="#20283C" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10">
                        <Expander IsExpanded="{Binding IsExpanded}"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="0">

                            <Expander.Header>
                                <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto" HorizontalAlignment="Stretch" Margin="0,2">
                                    <Border Grid.Column="0" Background="#1E2B45" CornerRadius="5" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding #PanelRoot.DeviceIconGlyph, StringFormat='{}{0} DEVICE'}" FontSize="10" FontWeight="Bold" Foreground="#3E7BFA"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                        <Button Content="✎"
                                                Width="22" Height="22"
                                                Padding="0"
                                                FontSize="10"
                                                Background="#1F283C"
                                                BorderBrush="#3D4B6E"
                                                BorderThickness="1"
                                                Foreground="#8B95A5"
                                                CornerRadius="4"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="Rename this device">
                                            <Button.Flyout>
                                                <Flyout Placement="Bottom" Opened="OnDeviceNicknameFlyoutOpened">
                                                    <StackPanel Width="240" Spacing="8" Margin="4">
                                                        <TextBlock Text="Rename Device" FontWeight="Bold" FontSize="12" Foreground="White"/>
                                                        <TextBlock Text="Shown instead of the raw device name everywhere this device appears." FontSize="10" Foreground="#8B95A5" TextWrapping="Wrap"/>
                                                        <TextBox Watermark="e.g. My Wheel" FontSize="12"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                            <Button Content="Clear" Click="OnClearDeviceNicknameClick" Background="#2A1B1F" BorderBrush="#552229" Foreground="#FFAAAA" Padding="8,4" CornerRadius="4" FontSize="11"/>
                                                            <Button Content="Save" Click="OnSaveDeviceNicknameClick" Background="#00B074" Foreground="White" Padding="12,4" CornerRadius="4" FontSize="11" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <Border Background="#1A202E" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding EntryCount, StringFormat='{}{0} Binds Active'}" FontSize="11" Foreground="#8B95A5"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Output As:" FontSize="11" Foreground="#8B95A5" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                        <Button Content="Xbox" FontSize="10" Padding="8,4" CornerRadius="4" Background="#161B26" BorderBrush="#2B354C" BorderThickness="1" Foreground="#BAC2DE" ToolTip.Tip="Replace this device's binds with a fresh Xbox Gamepad Auto-Bind preset">
                                            <Button.Flyout>
                                                <Flyout Placement="Bottom">
                                                    <StackPanel Width="230" Spacing="8" Margin="4">
                                                        <TextBlock Text="Replace binds as Xbox Gamepad?" FontWeight="Bold" FontSize="12" Foreground="White" TextWrapping="Wrap"/>
                                                        <TextBlock Text="Regenerates this device's binds from scratch as a virtual Xbox controller, replacing any custom targets you've set on it." FontSize="10" Foreground="#8B95A5" TextWrapping="Wrap"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                            <Button Content="Cancel" Click="OnCancelOutputAsFlyoutClick" Background="#161B26" Foreground="#BAC2DE" Padding="8,4" CornerRadius="4" FontSize="11"/>
                                                            <Button Content="Replace Binds" Click="OnConfirmOutputAsXboxClick" Background="#00B074" Foreground="White" Padding="12,4" CornerRadius="4" FontSize="11" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <Button Content="DS4" FontSize="10" Padding="8,4" CornerRadius="4" Background="#161B26" BorderBrush="#2B354C" BorderThickness="1" Foreground="#BAC2DE" ToolTip.Tip="Replace this device's binds with a fresh DualShock 4 Auto-Bind preset">
                                            <Button.Flyout>
                                                <Flyout Placement="Bottom">
                                                    <StackPanel Width="230" Spacing="8" Margin="4">
                                                        <TextBlock Text="Replace binds as DualShock 4?" FontWeight="Bold" FontSize="12" Foreground="White" TextWrapping="Wrap"/>
                                                        <TextBlock Text="Regenerates this device's binds from scratch as a virtual DualShock 4 controller, replacing any custom targets you've set on it." FontSize="10" Foreground="#8B95A5" TextWrapping="Wrap"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                            <Button Content="Cancel" Click="OnCancelOutputAsFlyoutClick" Background="#161B26" Foreground="#BAC2DE" Padding="8,4" CornerRadius="4" FontSize="11"/>
                                                            <Button Content="Replace Binds" Click="OnConfirmOutputAsDs4Click" Background="#00B074" Foreground="White" Padding="12,4" CornerRadius="4" FontSize="11" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <Button Content="Wheel" FontSize="10" Padding="8,4" CornerRadius="4" Background="#161B26" BorderBrush="#2B354C" BorderThickness="1" Foreground="#BAC2DE" ToolTip.Tip="Replace this device's binds with a fresh DirectInput Wheel Auto-Bind preset">
                                            <Button.Flyout>
                                                <Flyout Placement="Bottom">
                                                    <StackPanel Width="230" Spacing="8" Margin="4">
                                                        <TextBlock Text="Replace binds as DirectInput Wheel?" FontWeight="Bold" FontSize="12" Foreground="White" TextWrapping="Wrap"/>
                                                        <TextBlock Text="Regenerates this device's binds from scratch as a virtual DirectInput wheel, replacing any custom targets you've set on it." FontSize="10" Foreground="#8B95A5" TextWrapping="Wrap"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                            <Button Content="Cancel" Click="OnCancelOutputAsFlyoutClick" Background="#161B26" Foreground="#BAC2DE" Padding="8,4" CornerRadius="4" FontSize="11"/>
                                                            <Button Content="Replace Binds" Click="OnConfirmOutputAsWheelClick" Background="#00B074" Foreground="White" Padding="12,4" CornerRadius="4" FontSize="11" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Assign to Player:" FontSize="11" Foreground="#8B95A5" VerticalAlignment="Center" IsVisible="{Binding !#PanelRoot.IsWheelPage}"/>
                                        <TextBlock Text="Assign to Wheel Slot:" FontSize="11" Foreground="#8B95A5" VerticalAlignment="Center" IsVisible="{Binding #PanelRoot.IsWheelPage}"/>
                                        <ComboBox ItemsSource="{x:Static vm:MainWindowViewModel.PlayerTargets}"
                                                  PlaceholderText="Select Player..."
                                                  Width="180"
                                                  CornerRadius="5"
                                                  Background="#10141E"
                                                  FontSize="11"
                                                  IsVisible="{Binding !#PanelRoot.IsWheelPage}"
                                                  SelectionChanged="OnBulkTargetSelectionChanged">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:PlayerTargetOption">
                                                    <Grid ColumnDefinitions="Auto, *">
                                                        <Border Grid.Column="0" Background="{Binding BgColorHex}" BorderBrush="{Binding BorderColorHex}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding ShortBadge}" FontSize="10" FontWeight="Bold" Foreground="{Binding TextColorHex}"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox ItemsSource="{x:Static vm:MainWindowViewModel.WheelSlots}"
                                                  PlaceholderText="Select Wheel Slot..."
                                                  Width="180"
                                                  CornerRadius="5"
                                                  Background="#10141E"
                                                  FontSize="11"
                                                  IsVisible="{Binding #PanelRoot.IsWheelPage}"
                                                  SelectionChanged="OnBulkTargetSelectionChanged">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:WheelDeviceSlotOption">
                                                    <Grid ColumnDefinitions="Auto, *">
                                                        <Border Grid.Column="0" Background="{Binding BgColorHex}" BorderBrush="{Binding BorderColorHex}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding ShortBadge}" FontSize="10" FontWeight="Bold" Foreground="{Binding TextColorHex}"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Button Content="Select All"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectAllInGroupCommand}"
                                                CommandParameter="{Binding}"
                                                Background="#161B26" Foreground="#BAC2DE" FontSize="10" Padding="6,4" CornerRadius="4"/>
                                        <Button Content="Deselect"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeselectAllInGroupCommand}"
                                                CommandParameter="{Binding}"
                                                Background="#161B26" Foreground="#BAC2DE" FontSize="10" Padding="6,4" CornerRadius="4"/>
                                        <Button Content="🗑 Remove"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveSelectedInGroupCommand}"
                                                CommandParameter="{Binding}"
                                                Background="#2A1B1F" BorderBrush="#552229" Foreground="#FFAAAA" FontSize="10" Padding="6,4" CornerRadius="4"/>
                                        <Button Content="+ Add Key"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AddMappingToDeviceCommand}"
                                                CommandParameter="{Binding DeviceName}"
                                                Background="#1F283C" BorderBrush="#3D4B6E" Foreground="White" FontSize="11" Padding="10,4" CornerRadius="5"/>
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>

                            <ItemsControl ItemsSource="{Binding Entries}" HorizontalAlignment="Stretch" Margin="8,4,8,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:MappingEntry">
                                        <Grid Classes="mappingRow"
                                              ColumnDefinitions="32, 1.8*, 0.9*, 1.4*, 1.8*, 1.4*, 1*, 36"
                                              HorizontalAlignment="Stretch"
                                              Margin="0,3">

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>

                                            <Grid Grid.Column="1" ColumnDefinitions="*, Auto" Margin="3,0">
                                                <Button Grid.Column="0"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).StartListeningCommand}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        Padding="6,4"
                                                        Background="#1F283C"
                                                        BorderBrush="#3D4B6E"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        ToolTip.Tip="Click, then press the physical button or move the axis you want to bind">
                                                    <Grid ColumnDefinitions="Auto, *">
                                                        <Border Grid.Column="0"
                                                                x:DataType="converters:BadgeInfo"
                                                                DataContext="{Binding SourceDisplayName, Converter={StaticResource ButtonBadgeConverter}}"
                                                                IsVisible="{Binding HasBadge}"
                                                                Background="{Binding Background}"
                                                                BorderBrush="{Binding Border}"
                                                                BorderThickness="1"
                                                                CornerRadius="10"
                                                                Width="22" Height="22"
                                                                Margin="0,0,8,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Glyph}"
                                                                       Foreground="{Binding Foreground}"
                                                                       FontSize="12"
                                                                       FontWeight="Bold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding SourceDisplayName}"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Left"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </Button>

                                                <Button Grid.Column="1"
                                                        Content="✎"
                                                        Width="24" Height="24"
                                                        Margin="4,0,0,0"
                                                        Padding="0"
                                                        FontSize="11"
                                                        Background="#1F283C"
                                                        BorderBrush="#3D4B6E"
                                                        BorderThickness="1"
                                                        Foreground="#8B95A5"
                                                        CornerRadius="4"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding IsBound}"
                                                        ToolTip.Tip="Rename this physical input">
                                                    <Button.Flyout>
                                                        <Flyout Placement="Bottom" Opened="OnNicknameFlyoutOpened">
                                                            <StackPanel Width="240" Spacing="8" Margin="4">
                                                                <TextBlock Text="Rename Physical Input" FontWeight="Bold" FontSize="12" Foreground="White"/>
                                                                <TextBlock Text="Shown instead of the auto-detected name everywhere this input appears." FontSize="10" Foreground="#8B95A5" TextWrapping="Wrap"/>
                                                                <TextBox Watermark="e.g. Paddle Left" FontSize="12"/>
                                                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                                    <Button Content="Clear" Click="OnClearNicknameClick" Background="#2A1B1F" BorderBrush="#552229" Foreground="#FFAAAA" Padding="8,4" CornerRadius="4" FontSize="11"/>
                                                                    <Button Content="Save" Click="OnSaveNicknameClick" Background="#00B074" Foreground="White" Padding="12,4" CornerRadius="4" FontSize="11" FontWeight="Bold"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>

                                            <ComboBox Grid.Column="2"
                                                      SelectedItem="{Binding SourceType}"
                                                      HorizontalAlignment="Stretch"
                                                      MinWidth="60"
                                                      Margin="3,0"
                                                      CornerRadius="6"
                                                      Background="#161B26"
                                                      ToolTip.Tip="Axis = analog stick/pedal/wheel input; Button = digital press">
                                                <models:InputType>Axis</models:InputType>
                                                <models:InputType>Button</models:InputType>
                                            </ComboBox>

                                            <ComboBox Grid.Column="3"
                                                      ItemsSource="{x:Static vm:MainWindowViewModel.PlayerTargets}"
                                                      SelectedValue="{Binding TargetDeviceId}"
                                                      SelectedValueBinding="{Binding Id}"
                                                      IsVisible="{Binding ShowPlayerCombo}"
                                                      HorizontalAlignment="Stretch"
                                                      MinWidth="90"
                                                      Margin="3,0"
                                                      CornerRadius="6"
                                                      Background="#161B26">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="models:PlayerTargetOption">
                                                        <Grid ColumnDefinitions="Auto, *">
                                                            <Border Grid.Column="0" Background="{Binding BgColorHex}" BorderBrush="{Binding BorderColorHex}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding ShortBadge}" FontSize="10" FontWeight="Bold" Foreground="{Binding TextColorHex}"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <ComboBox Grid.Column="3"
                                                      ItemsSource="{x:Static vm:MainWindowViewModel.WheelSlots}"
                                                      SelectedValue="{Binding TargetDeviceId}"
                                                      SelectedValueBinding="{Binding Id}"
                                                      IsVisible="{Binding ShowWheelSlotCombo}"
                                                      HorizontalAlignment="Stretch"
                                                      MinWidth="90"
                                                      Margin="3,0"
                                                      CornerRadius="6"
                                                      Background="#161B26">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="models:WheelDeviceSlotOption">
                                                        <Grid ColumnDefinitions="Auto, *">
                                                            <Border Grid.Column="0" Background="{Binding BgColorHex}" BorderBrush="{Binding BorderColorHex}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding ShortBadge}" FontSize="10" FontWeight="Bold" Foreground="{Binding TextColorHex}"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <Panel Grid.Column="4" Margin="3,0">
                                                <ComboBox ItemsSource="{x:Static vm:MainWindowViewModel.AvailableVirtualOutputs}"
                                                          SelectedItem="{Binding TargetOutput}"
                                                          MaxDropDownHeight="300"
                                                          IsVisible="{Binding !IsKeyboardTarget}"
                                                          HorizontalAlignment="Stretch"
                                                          MinWidth="140"
                                                          CornerRadius="6"
                                                          Background="#161B26"
                                                          ToolTip.Tip="Which virtual channel this input feeds - pick '[Keyboard] (Click to choose a key…)' to simulate a keyboard press instead">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Grid ColumnDefinitions="Auto, *" x:CompileBindings="False">
                                                                <Border Grid.Column="0"
                                                                        x:DataType="converters:BadgeInfo"
                                                                        DataContext="{Binding Converter={StaticResource ButtonBadgeConverter}}"
                                                                        IsVisible="{Binding HasBadge}"
                                                                        Background="{Binding Background}"
                                                                        BorderBrush="{Binding Border}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="10"
                                                                        Width="20" Height="20"
                                                                        Margin="0,0,8,0"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Glyph}"
                                                                               Foreground="{Binding Foreground}"
                                                                               FontSize="11"
                                                                               FontWeight="Bold"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding}"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>

                                                <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding IsKeyboardTarget}">
                                                    <Button Grid.Column="0"
                                                            Content="{Binding TargetOutput}"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Padding="8,4"
                                                            Background="#161B26"
                                                            BorderBrush="#3D4B6E"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Foreground="White"
                                                            FontSize="11"
                                                            ToolTip.Tip="Search for a key, or press one live">
                                                        <Button.Flyout>
                                                            <Flyout Placement="Bottom" Opened="OnKeyPickerFlyoutOpened">
                                                                <StackPanel Width="220" Spacing="8" Margin="4">
                                                                    <TextBlock Text="Bind to Keyboard Key" FontWeight="Bold" FontSize="12" Foreground="White"/>
                                                                    <TextBox Watermark="Search keys…" FontSize="12" TextChanged="OnKeySearchTextChanged"/>
                                                                    <Button Content="🔴 Press a Key"
                                                                            HorizontalAlignment="Stretch"
                                                                            HorizontalContentAlignment="Center"
                                                                            Background="#1F283C"
                                                                            BorderBrush="#3D4B6E"
                                                                            Foreground="White"
                                                                            FontSize="11"
                                                                            Padding="6,6"
                                                                            CornerRadius="4"
                                                                            Click="OnPressKeyToggleClick"/>
                                                                    <ListBox MaxHeight="220"
                                                                             Background="#0D1119"
                                                                             SelectionChanged="OnKeyListSelectionChanged"/>
                                                                </StackPanel>
                                                            </Flyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                    <Button Grid.Column="1"
                                                            Content="↩"
                                                            Width="24" Height="24"
                                                            Margin="4,0,0,0"
                                                            Padding="0"
                                                            FontSize="12"
                                                            Background="#1F283C"
                                                            BorderBrush="#3D4B6E"
                                                            Foreground="#8B95A5"
                                                            CornerRadius="4"
                                                            Click="OnResetKeyboardTargetClick"
                                                            ToolTip.Tip="Reset to a virtual-gamepad target"/>
                                                </Grid>
                                            </Panel>

                                            <Panel Grid.Column="5" Margin="4,0" HorizontalAlignment="Stretch">
                                                <Grid ColumnDefinitions="*, 36" IsVisible="{Binding IsAxis}" HorizontalAlignment="Stretch">
                                                    <Slider Grid.Column="0"
                                                            Minimum="0.0"
                                                            Maximum="0.5"
                                                            Value="{Binding Deadzone}"
                                                            HorizontalAlignment="Stretch"
                                                            MinWidth="60"
                                                            VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Deadzone, StringFormat='{}{0:P0}'}"
                                                               FontSize="11"
                                                               Foreground="#8B95A5"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Right"/>
                                                </Grid>
                                                <TextBlock Text="—"
                                                           Foreground="#4B5563"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding !IsAxis}"/>
                                            </Panel>

                                            <Panel Grid.Column="6" Margin="3,0" HorizontalAlignment="Stretch">
                                                <Button Content="Calibrate"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenCalibrationCommand}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Center"
                                                        Background="#1B2130"
                                                        BorderBrush="#2B354C"
                                                        CornerRadius="6"
                                                        IsVisible="{Binding IsAxis}"/>
                                                <TextBlock Text="—"
                                                           Foreground="#4B5563"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding !IsAxis}"/>
                                            </Panel>

                                            <Button Grid.Column="7"
                                                    Content="✕"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveMappingCommand}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="#FF5C5C"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontWeight="Bold"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
