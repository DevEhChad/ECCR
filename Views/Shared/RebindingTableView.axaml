<!--
    Binder page "Bindings" tab list: one flat, single-device-scoped row per MappingEntry -
    badge + Input Name + Detected Input (click arms physical-press capture directly) + Assigned
    Key + a primary "Rebind" button (opens a searchable-key popup) + an overflow "⚙" flyout
    holding Deadzone/Invert/Calibrate/Player-or-Wheel-Slot/Remove, so the main row stays as flat
    as the reference mockup while keeping every control the app's now-removed denser grid view
    already had. Compiled bindings stay ON for the whole file (x:DataType is the common
    ViewModelBase, since the real inherited DataContext differs by host page) - the
    "$parent[Window].((vm:X)DataContext)" cast syntax used deep in the row templates requires
    compiled bindings.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ECCR.ViewModels"
             xmlns:models="using:ECCR.Models"
             xmlns:converters="using:ECCR.Converters"
             x:Class="ECCR.Views.Shared.RebindingTableView"
             x:Name="PanelRoot"
             x:DataType="vm:ViewModelBase">

    <UserControl.Resources>
        <converters:ButtonBadgeConverter x:Key="ButtonBadgeConverter"/>
        <converters:SemanticInputNameConverter x:Key="SemanticInputNameConverter"/>
        <converters:RebindTitleConverter x:Key="RebindTitleConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Grid.rebindRow:pointerover">
            <Setter Property="Background" Value="#161C2A"/>
        </Style>
    </UserControl.Styles>

    <Border Classes="card">
        <Grid RowDefinitions="Auto, Auto, Auto, Auto, *">
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                <TextBlock Grid.Column="0" Text="REBINDING TABLE" FontWeight="Bold" FontSize="13" Foreground="#BAC2DE" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="+ Add Input" FontSize="11" Padding="10,6" CornerRadius="6"
                        Background="#1F283C" BorderBrush="#3D4B6E" Foreground="White"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AddMappingToDeviceCommand}"
                        CommandParameter="{Binding #PanelRoot.DeviceName}"
                        ToolTip.Tip="Adds a new unbound row for this device - click Rebind, then press a button or move an axis"/>
            </Grid>

            <TextBox Grid.Row="1"
                     Text="{Binding #PanelRoot.SearchText}"
                     Watermark="Search inputs…"
                     Margin="0,0,0,10"
                     Padding="10,7"
                     CornerRadius="6"
                     Background="#121622"
                     BorderBrush="#20283C"
                     FontSize="12"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,0,0,10">
                <Button Content="Select All" FontSize="11" Padding="8,5" CornerRadius="5" Background="#1F283C" BorderBrush="#3D4B6E" Foreground="#D0D0E0"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectAllInGroupCommand}"
                        CommandParameter="{Binding #PanelRoot.DeviceMappingGroup}"/>
                <Button Content="Deselect All" FontSize="11" Padding="8,5" CornerRadius="5" Background="#1F283C" BorderBrush="#3D4B6E" Foreground="#D0D0E0"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeselectAllInGroupCommand}"
                        CommandParameter="{Binding #PanelRoot.DeviceMappingGroup}"/>
                <Button Content="🗑 Remove Selected" FontSize="11" Padding="8,5" CornerRadius="5" Background="#2A1B1F" BorderBrush="#552229" Foreground="#FFAAAA"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveSelectedInGroupCommand}"
                        CommandParameter="{Binding #PanelRoot.DeviceMappingGroup}"/>
                <Button Content="Restore Hidden Inputs" FontSize="11" Padding="8,5" CornerRadius="5" Background="#1F283C" BorderBrush="#3D4B6E" Foreground="#D0D0E0"
                        IsVisible="{Binding $parent[UserControl].((vm:BinderPageViewModel)DataContext).HasHiddenInputs}"
                        Command="{Binding $parent[UserControl].((vm:BinderPageViewModel)DataContext).RestoreHiddenInputsCommand}"
                        ToolTip.Tip="Bring back every unbound row you've dismissed with its ✕ button"/>
                <ToggleButton Content="Show All Inputs" FontSize="11" Padding="8,5" CornerRadius="5" Background="#1F283C" BorderBrush="#3D4B6E" Foreground="#D0D0E0"
                        IsChecked="{Binding $parent[UserControl].((vm:BinderPageViewModel)DataContext).IsShowAllInputsEnabled, Mode=TwoWay}"
                        ToolTip.Tip="List every physical input this device reports, bound or not - off by default so the table only shows what's actually bound"/>
            </StackPanel>

            <TextBlock Grid.Row="3" Text="No bindings yet for this device - click + Add Input above." FontSize="12" Foreground="#8B95A5"
                       IsVisible="{Binding !#PanelRoot.HasEntries}" Margin="4,8"/>

            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding #PanelRoot.FilteredEntries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:MappingEntry">
                        <Grid Classes="rebindRow"
                              ColumnDefinitions="24, 36, 1.6*, 1.2*, 1.2*, Auto, Auto"
                              Margin="0,4"
                              Background="Transparent">

                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" IsVisible="{Binding !IsPlaceholder}"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"/>

                            <Border Grid.Column="1"
                                    x:DataType="converters:BadgeInfo"
                                    DataContext="{Binding SourceDisplayName, Converter={StaticResource ButtonBadgeConverter}}"
                                    IsVisible="{Binding HasBadge}"
                                    Background="{Binding Background}"
                                    BorderBrush="{Binding Border}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Width="24" Height="24"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Glyph}" Foreground="{Binding Foreground}" FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0">
                                <TextBlock FontWeight="SemiBold" FontSize="12.5" Foreground="White"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource SemanticInputNameConverter}">
                                            <Binding Path="SourceDisplayName"/>
                                            <Binding Path="SemanticHotspot"/>
                                            <Binding Path="SourceDeviceName"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>

                            <Button Grid.Column="3"
                                    Content="{Binding SourceDisplayName}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).StartListeningCommand}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Margin="4,0" Padding="8,5"
                                    Background="#1F283C" BorderBrush="#3D4B6E" BorderThickness="1" CornerRadius="6"
                                    Foreground="#D0D0E0" FontSize="11.5"
                                    ToolTip.Tip="Click, then press the physical button or move the axis you want to bind"/>

                            <Border Grid.Column="4" Margin="4,0" Padding="8,5" CornerRadius="6"
                                    Background="#161B26" BorderBrush="#2B354C" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TargetOutputDisplay}" FontSize="11.5" Foreground="#D0D0E0" TextTrimming="CharacterEllipsis"/>
                            </Border>

                            <Button Grid.Column="5" Classes="primary" Content="Rebind" FontSize="11.5" Padding="12,7" Margin="8,0,4,0">
                                <Button.Flyout>
                                    <Flyout Placement="Bottom" Opened="OnRebindFlyoutOpened">
                                        <StackPanel Width="260" Spacing="8" Margin="4">
                                            <TextBlock Text="{Binding Converter={StaticResource RebindTitleConverter}}"
                                                       FontWeight="Bold" FontSize="12" Foreground="White" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).MappingStatus}"
                                                       FontSize="11" Foreground="{DynamicResource AccentPurpleTextBrush}"
                                                       IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsPickingKeyboardKey}"/>
                                            <Button Content="⌨ Press a Key" Click="OnPressKeyToggleClick"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                    Background="{DynamicResource AccentPurpleBackgroundBrush}" BorderBrush="{DynamicResource AccentPurpleBrush}"
                                                    Foreground="{DynamicResource AccentPurpleTextBrush}" FontSize="11" Padding="6,7" CornerRadius="4"/>
                                            <TextBox Watermark="Search Xbox / PS4 / Wheel / Keyboard targets…" FontSize="12" TextChanged="OnKeySearchTextChanged"/>
                                            <ListBox MaxHeight="220" Background="#0D1119" SelectionChanged="OnKeyListSelectionChanged"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                <Button Content="Cancel" Click="OnRebindCancelClick" Background="#161B26" Foreground="#BAC2DE" Padding="10,5" CornerRadius="4" FontSize="11"/>
                                                <Button Content="Accept" Click="OnRebindAcceptClick" Classes="primary" Padding="10,5" CornerRadius="4" FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <Button Grid.Column="6" Content="✕" Width="30" Height="30" Padding="0" FontSize="13"
                                    IsVisible="{Binding IsPlaceholder}"
                                    Command="{Binding $parent[UserControl].((vm:BinderPageViewModel)DataContext).HidePlaceholderInputCommand}"
                                    CommandParameter="{Binding}"
                                    Background="#1F283C" BorderBrush="#3D4B6E" BorderThickness="1" Foreground="#8B95A5" CornerRadius="6"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center"
                                    ToolTip.Tip="Dismiss this input from the table - it's not bound to anything, this just hides the row. Restore it from 'Restore Hidden Inputs' above."/>

                            <Button Grid.Column="6" Content="⚙" Width="30" Height="30" Padding="0" FontSize="13"
                                    IsVisible="{Binding !IsPlaceholder}"
                                    Background="#1F283C" BorderBrush="#3D4B6E" BorderThickness="1" Foreground="#BAC2DE" CornerRadius="6"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center">
                                <Button.Flyout>
                                    <Flyout Placement="Bottom">
                                        <StackPanel Width="230" Spacing="10" Margin="4">
                                            <StackPanel Spacing="4" IsVisible="{Binding IsAxis}">
                                                <TextBlock Text="Dead Zone" FontSize="11" Foreground="#8B95A5"/>
                                                <Grid ColumnDefinitions="*, 40">
                                                    <Slider Grid.Column="0" Minimum="0.0" Maximum="0.5" Value="{Binding Deadzone}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Deadzone, StringFormat='{}{0:P0}'}" FontSize="11" Foreground="#8B95A5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>
                                            <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding IsAxis}">
                                                <TextBlock Grid.Column="0" Text="Invert" FontSize="12" Foreground="#D0D0E0" VerticalAlignment="Center"/>
                                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsInverted}" OnContent="" OffContent=""/>
                                            </Grid>
                                            <Button Content="Calibrate…" IsVisible="{Binding IsAxis}"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenCalibrationCommand}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                    Background="#161B26" BorderBrush="#2B354C" CornerRadius="6" Padding="8,6" FontSize="11"/>

                                            <ComboBox ItemsSource="{x:Static vm:MainWindowViewModel.PlayerTargets}"
                                                      SelectedValue="{Binding TargetDeviceId}"
                                                      SelectedValueBinding="{Binding Id}"
                                                      IsVisible="{Binding ShowPlayerCombo}"
                                                      HorizontalAlignment="Stretch" CornerRadius="6" Background="#161B26" FontSize="11">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="models:PlayerTargetOption">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <ComboBox ItemsSource="{x:Static vm:MainWindowViewModel.WheelSlots}"
                                                      SelectedValue="{Binding TargetDeviceId}"
                                                      SelectedValueBinding="{Binding Id}"
                                                      IsVisible="{Binding ShowWheelSlotCombo}"
                                                      HorizontalAlignment="Stretch" CornerRadius="6" Background="#161B26" FontSize="11">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="models:WheelDeviceSlotOption">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <Button Content="Clear Binding" IsVisible="{Binding IsBound}"
                                                    ToolTip.Tip="Unassigns this input's physical binding without deleting the row - it goes back to 'Click to Bind'"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ClearMappingCommand}"
                                                    CommandParameter="{Binding}"
                                                    Background="#1F283C" BorderBrush="#3D4B6E" Foreground="#D0D0E0"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,6" CornerRadius="6" FontSize="11"/>
                                            <Button Content="Remove Binding" Classes="danger"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveMappingCommand}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="11"/>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
