<!--
    Device Mappings page "Input Matrix" tab: a capability-driven diagnostic grid, one tile per physical
    digital button/POV-hat direction the selected device reports plus one gauge card per reported
    analog axis - the generic complement to DeviceMappingDiagramView's fixed artwork, which places no
    hotspots for face buttons/paddles since those shift with whatever rim/box is attached. Both
    grids reflow in a WrapPanel (input counts vary wildly by device) and update live from the same
    DirectInput poll feed the visual diagram uses. Illumination is strictly momentary - a tile/
    gauge reflects exactly the current polled state with no afterglow. Clicking a button tile
    opens a small nickname editor; clicking an axis card opens a quick-assign-to-target picker.
    Both flyouts follow the Device Mapping Table's Cancel/Apply, Escape/Enter convention. A collapsible
    "Hardware Diagnostics" panel exposes the raw packet (button bitmask, POV angle, raw axis
    ints) for troubleshooting, and a tile still held past ~30s gets a "stuck?" warning icon.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ECCR.ViewModels"
             xmlns:converters="using:ECCR.Converters"
             x:Class="ECCR.Views.Shared.InputMatrixView"
             x:DataType="vm:InputMatrixViewModel">

    <UserControl.Resources>
        <converters:CenteredAxisFillConverter x:Key="CenteredAxisFillConverter"/>
    </UserControl.Resources>

    <Border Classes="card" Padding="18">
        <Grid RowDefinitions="Auto, Auto, Auto, Auto">

            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                <TextBlock Grid.Column="0" Text="INPUT MATRIX" FontWeight="Bold" FontSize="13" Foreground="#BAC2DE" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Content="Auto-Map (1:1)" FontSize="12" Padding="12,7" CornerRadius="6"
                            Background="#1F283C" BorderBrush="#3D4B6E" Foreground="White"
                            Command="{Binding AutoMapCommand}"
                            ToolTip.Tip="Maps every physical button/POV/axis this device reports directly to its identity virtual slot (Button N -&#8594; Wheel Button N), clearing any of this device's mappings outside that set. Preserves nicknames."/>
                    <Button Content="Export Device Config" FontSize="12" Padding="12,7" CornerRadius="6"
                            Background="#1F283C" BorderBrush="#3D4B6E" Foreground="White"
                            Command="{Binding ExportDeviceConfigCommand}"/>
                    <Button Content="Import Device Config" FontSize="12" Padding="12,7" CornerRadius="6"
                            Background="#1F283C" BorderBrush="#3D4B6E" Foreground="White"
                            Command="{Binding ImportDeviceConfigCommand}"/>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1" Text="No physical buttons reported for this device." FontSize="12" Foreground="#8B95A5"
                       IsVisible="{Binding !HasTiles}" Margin="4,8"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="360" IsVisible="{Binding HasTiles}">
                <ItemsControl ItemsSource="{Binding Tiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:InputMatrixTileViewModel">
                            <Button Classes="matrixTile"
                                    Classes.matrixTilePressed="{Binding IsPressed}"
                                    HorizontalContentAlignment="Stretch"
                                    ToolTip.Tip="Click to set a nickname for this input">
                                <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding PrimaryLabel}" FontSize="12.5" FontWeight="SemiBold" Foreground="White"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        <TextBlock Text="{Binding SecondaryLabel}" FontSize="10.5" Foreground="#8B95A5"
                                                   IsVisible="{Binding HasNickname}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Classes="matrixGhostIcon" Text="&#9888;" Margin="4,0,0,0"
                                               IsVisible="{Binding IsGhostSuspect}"
                                               ToolTip.Tip="Held continuously for 30+ seconds - possible stuck or shorted switch"/>
                                </Grid>
                                <Button.Flyout>
                                    <Flyout Placement="Bottom" Opened="OnTileFlyoutOpened" Closed="OnTileFlyoutClosed">
                                        <StackPanel Width="240" Spacing="8" Margin="4" KeyDown="OnTileFlyoutKeyDown">
                                            <TextBlock Text="{Binding DefaultLabel, StringFormat='Editing Nickname for {0}'}"
                                                       FontWeight="Bold" FontSize="12" Foreground="White" TextWrapping="Wrap"/>
                                            <TextBox Watermark="e.g. Left Paddle" FontSize="12"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                <Button Content="Cancel" Click="OnTileCancelClick" Background="#161B26" Foreground="#BAC2DE" Padding="10,5" CornerRadius="4" FontSize="11"/>
                                                <Button Content="Clear Nickname" Click="OnTileClearClick" Background="#2A1B1F" BorderBrush="#552229" Foreground="#FFAAAA" Padding="10,5" CornerRadius="4" FontSize="11"/>
                                                <Button Content="Apply" Click="OnTileApplyClick" Classes="primary" Padding="10,5" CornerRadius="4" FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Spacing="8" Margin="0,14,0,0" IsVisible="{Binding HasAxisTiles}">
                <TextBlock Text="ANALOG AXES" FontWeight="Bold" FontSize="13" Foreground="#BAC2DE"/>
                <ItemsControl ItemsSource="{Binding AxisTiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:InputMatrixAxisTileViewModel">
                            <Panel>
                                <Button Classes="matrixAxisCard" HorizontalContentAlignment="Stretch"
                                        ToolTip.Tip="Click to assign this axis to a virtual steering/pedal slot">
                                    <Grid RowDefinitions="Auto, Auto, Auto, Auto" ColumnDefinitions="*, Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" Margin="0,0,20,0"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RawValue}" FontSize="10.5" Foreground="#8B95A5"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding SecondaryLabel}" FontSize="10.5" Foreground="#8B95A5"
                                                   IsVisible="{Binding HasNickname}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>

                                        <!-- Centered bidirectional bar (steering-like axes): fill grows from the center line either left or right. -->
                                        <Canvas Grid.Row="2" Grid.ColumnSpan="2" Width="120" Height="14" Margin="0,6" Background="#0D1119"
                                                IsVisible="{Binding IsCentered}">
                                            <Rectangle Canvas.Top="0" Height="14" Classes="matrixAxisFill"
                                                       Canvas.Left="{Binding CenteredOffset, Converter={StaticResource CenteredAxisFillConverter}, ConverterParameter=Left}"
                                                       Width="{Binding CenteredOffset, Converter={StaticResource CenteredAxisFillConverter}, ConverterParameter=Width}"/>
                                            <Line StartPoint="60,0" EndPoint="60,14" Stroke="#3D4B6E" StrokeThickness="1"/>
                                        </Canvas>

                                        <!-- Unidirectional fill bar (pedals/sliders): plain left-anchored fill, 0-100%. -->
                                        <Border Grid.Row="2" Grid.ColumnSpan="2" Width="120" Height="14" Margin="0,6" Background="#0D1119" CornerRadius="3"
                                                IsVisible="{Binding !IsCentered}" HorizontalAlignment="Left">
                                            <Border CornerRadius="3" Background="{DynamicResource AccentGreenSolidBrush}" HorizontalAlignment="Left"
                                                    Width="{Binding NormalizedValue, Converter={StaticResource CenteredAxisFillConverter}, ConverterParameter=UnidirectionalWidth}"/>
                                        </Border>

                                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding PercentDisplay, StringFormat='{}{0:0}%'}" FontSize="10.5" Foreground="#8B95A5" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom" Opened="OnAxisFlyoutOpened" Closed="OnAxisFlyoutClosed">
                                            <StackPanel Width="260" Spacing="8" Margin="4">
                                                <TextBlock Text="{Binding DisplayName, StringFormat='Assign {0} to…'}"
                                                           FontWeight="Bold" FontSize="12" Foreground="White" TextWrapping="Wrap"/>
                                                <TextBox Watermark="Search Xbox / PS4 / Wheel targets…" FontSize="12" TextChanged="OnAxisSearchTextChanged"/>
                                                <ListBox MaxHeight="220" Background="#0D1119" SelectionChanged="OnAxisTargetSelected"/>
                                                <Button Content="Cancel" Click="OnAxisCancelClick" Background="#161B26" Foreground="#BAC2DE" Padding="10,5" CornerRadius="4" FontSize="11" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>

                                <Button Classes="rowIconButton" Content="✎" Width="22" Height="22" Padding="0" FontSize="12"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                                        Background="#1F283C" BorderBrush="#3D4B6E" BorderThickness="1" Foreground="#BAC2DE" CornerRadius="5"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        ToolTip.Tip="Set a custom alias for this axis">
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom" Opened="OnAxisNicknameFlyoutOpened" Closed="OnAxisNicknameFlyoutClosed">
                                            <StackPanel Width="240" Spacing="8" Margin="4" KeyDown="OnAxisNicknameFlyoutKeyDown">
                                                <TextBlock Text="{Binding DefaultLabel, StringFormat='Editing Alias for {0}'}"
                                                           FontWeight="Bold" FontSize="12" Foreground="White" TextWrapping="Wrap"/>
                                                <TextBox Watermark="e.g. Throttle, Load Cell Brake" FontSize="12"/>
                                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                    <Button Content="Cancel" Click="OnAxisNicknameCancelClick" Background="#161B26" Foreground="#BAC2DE" Padding="10,5" CornerRadius="4" FontSize="11"/>
                                                    <Button Content="Reset to Default" Click="OnAxisNicknameClearClick" Background="#2A1B1F" BorderBrush="#552229" Foreground="#FFAAAA" Padding="10,5" CornerRadius="4" FontSize="11"/>
                                                    <Button Content="Apply" Click="OnAxisNicknameApplyClick" Classes="primary" Padding="10,5" CornerRadius="4" FontSize="11"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Expander Grid.Row="3" Header="Hardware Diagnostics" IsExpanded="False" Margin="0,14,0,0">
                <StackPanel Spacing="6" Margin="8">
                    <TextBlock FontSize="11" Foreground="#BAC2DE">
                        <Run Text="Button Bitmask: "/><Run Text="{Binding ButtonBitmaskHex}"/><Run Text=" ("/><Run Text="{Binding ButtonBitmaskDecimal}"/><Run Text=")"/>
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="#BAC2DE">
                        <Run Text="POV Angle: "/><Run Text="{Binding PovAngleDisplay}"/>
                    </TextBlock>
                    <TextBlock Text="Raw Axis Values" FontSize="11" FontWeight="SemiBold" Foreground="#BAC2DE" Margin="0,4,0,0"/>
                    <ItemsControl ItemsSource="{Binding AxisTiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:InputMatrixAxisTileViewModel">
                                <TextBlock FontSize="11" Foreground="#8B95A5">
                                    <Run Text="{Binding DisplayName}"/><Run Text=": "/><Run Text="{Binding RawValue}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>

        </Grid>
    </Border>
</UserControl>
