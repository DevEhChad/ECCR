<!--
    Main window: DataContext is MainWindowViewModel. Most "dialogs" here (dependency banner,
    Settings, Update prompts, Create Profile) are IsVisible-toggled overlay Borders stacked
    in the outer Grid at the bottom of this file, not separate windows - see MainWindow.axaml.cs
    for the two real exceptions (Auto-Bind Wizard, Calibration).

    A recurring pattern worth knowing before reading further: rows inside GroupedMappings/
    Mappings ItemsControls are rendered via DataTemplates whose own DataContext is the row
    item (a DeviceMappingGroup or MappingEntry), not this window's view model. Anything in
    those templates that needs to call back to MainWindowViewModel (e.g. RemoveMappingCommand)
    reaches it via the compiled-binding path "#RootWindow.((vm:MainWindowViewModel)DataContext).X",
    using this window's own x:Name (RootWindow, set below) to hop back out to its DataContext.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ECCR.ViewModels"
        xmlns:models="using:ECCR.Models"
        xmlns:services="using:ECCR.Services"
        xmlns:views="using:ECCR.Views"
        xmlns:converters="using:ECCR.Converters"
        mc:Ignorable="d"
        d:DesignWidth="1100" 
        d:DesignHeight="700"
        Width="1100"
        Height="700"
        MinWidth="980"
        MinHeight="680"
        x:Class="ECCR.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="RootWindow"
        Background="#0E1118"
        Foreground="White"
        Icon="/Assets/ECCR-logo.ico"
        Title="{Binding WindowTitle}"
        FontSize="14">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <converters:ButtonBadgeConverter x:Key="ButtonBadgeConverter"/>
        <converters:BoolToRepairTextConverter x:Key="BoolToRepairTextConverter"/>
    </Window.Resources>

    <Grid>
        <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" Margin="16,10">
            
            <!-- ROW 0: Top Header -->
            <Border Grid.Row="0" Background="#121622" BorderBrush="#20283C" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Viewbox Width="26" Height="26" VerticalAlignment="Center">
                            <Canvas Width="48" Height="48">
                                <Ellipse Canvas.Left="2" Canvas.Top="2" Width="44" Height="44" Stroke="#3E7BFA" StrokeThickness="3.5" Fill="#121620"/>
                                <Rectangle Canvas.Left="12" Canvas.Top="14" Width="24" Height="20" RadiusX="6" RadiusY="6" Fill="#1E2B45" Stroke="#00E599" StrokeThickness="1.5"/>
                                <Rectangle Canvas.Left="16" Canvas.Top="21" Width="4" Height="6" Fill="#BAC2DE"/>
                                <Rectangle Canvas.Left="15" Canvas.Top="22" Width="6" Height="4" Fill="#BAC2DE"/>
                                <Ellipse Canvas.Left="28" Canvas.Top="20" Width="3" Height="3" Fill="#FF4D6D"/>
                                <Ellipse Canvas.Left="26" Canvas.Top="23" Width="3" Height="3" Fill="#3E7BFA"/>
                                <Ellipse Canvas.Left="30" Canvas.Top="23" Width="3" Height="3" Fill="#00E599"/>
                                <Ellipse Canvas.Left="28" Canvas.Top="26" Width="3" Height="3" Fill="#FFB900"/>
                            </Canvas>
                        </Viewbox>
                        
                        <TextBlock Text="EhChads Controller Remapper" FontWeight="Bold" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <ToggleSwitch IsChecked="{Binding IsVirtualOutputActive}"
                                      OnContent="Virtual Devices ON"
                                      OffContent="Virtual Devices OFF"
                                      FontSize="11"
                                      FontWeight="SemiBold"
                                      VerticalAlignment="Center"/>

                        <Button Content="🛡 HidHide" Command="{Binding HidHide.OpenHidHideMenuCommand}" Background="#2A1B3D" BorderBrush="#5E3B8A" FontSize="11" Padding="8,4" CornerRadius="5"/>
                        <Button Content="⚡ Auto-Bind" Command="{Binding AutoBind.OpenAutoBindWizardCommand}" Background="#1E2B45" BorderBrush="#3E7BFA" Foreground="#70A0FF" FontSize="11" Padding="8,4" CornerRadius="5"/>
                        <Button Content="⚙️ Settings" Command="{Binding OpenSettingsCommand}" Background="#1F283C" BorderBrush="#3D4B6E" Foreground="White" FontSize="11" Padding="8,4" CornerRadius="5"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ROW 1: Dependency Banner -->
            <Border Grid.Row="1" 
                    IsVisible="{Binding IsDependencyBannerOpen}" 
                    Background="#241519" 
                    BorderBrush="#552229" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="14,8" 
                    Margin="0,0,0,10">
                <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                    <TextBlock Grid.Column="0" Text="⚠️" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="System Driver Status &amp; Missing Services" FontWeight="Bold" FontSize="12" Foreground="#FFAAAA"/>
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                <TextBlock Text="ViGEmBus: " FontSize="11" Foreground="#888899"/>
                                <TextBlock Text="Not Installed" Foreground="#FF6B6B" FontSize="11" FontWeight="SemiBold" IsVisible="{Binding !IsViGEmInstalled}"/>
                                <TextBlock Text="Active" Foreground="#00E599" FontSize="11" FontWeight="SemiBold" IsVisible="{Binding IsViGEmInstalled}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                <TextBlock Text="HidHide: " FontSize="11" Foreground="#888899"/>
                                <TextBlock Text="Not Installed" Foreground="#FF6B6B" FontSize="11" FontWeight="SemiBold" IsVisible="{Binding !IsHidHideServiceInstalled}"/>
                                <TextBlock Text="Active" Foreground="#00E599" FontSize="11" FontWeight="SemiBold" IsVisible="{Binding IsHidHideServiceInstalled}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="vJoy: " FontSize="11" Foreground="#888899"/>
                                <TextBlock Text="Not Installed" Foreground="#FF6B6B" FontSize="11" FontWeight="SemiBold" IsVisible="{Binding !IsVJoyInstalled}"/>
                                <TextBlock Text="Active" Foreground="#00E599" FontSize="11" FontWeight="SemiBold" IsVisible="{Binding IsVJoyInstalled}"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="10,0">
                        <Button Content="+ Install ViGEm" Command="{Binding InstallViGEmCommand}" 
                                IsVisible="{Binding !IsViGEmInstalled}" IsEnabled="{Binding !IsBusyWithDriverAction}"
                                Background="#3E7BFA" Foreground="White" FontSize="11" Padding="8,4" CornerRadius="4"/>
                        <Button Content="+ Install HidHide" Command="{Binding InstallHidHideCommand}" 
                                IsVisible="{Binding !IsHidHideServiceInstalled}" IsEnabled="{Binding !IsBusyWithDriverAction}"
                                Background="#7A3EFA" Foreground="White" FontSize="11" Padding="8,4" CornerRadius="4"/>
                        <Button Content="+ Install vJoy" Command="{Binding InstallVJoyCommand}" 
                                IsVisible="{Binding !IsVJoyInstalled}" IsEnabled="{Binding !IsBusyWithDriverAction}"
                                Background="#00B074" Foreground="White" FontSize="11" Padding="8,4" CornerRadius="4"/>
                    </StackPanel>

                    <Button Grid.Column="3" Content="✕" Command="{Binding DismissDependencyBannerCommand}" 
                            Background="Transparent" Foreground="#FFAAAA" Padding="6,2" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ROW 2: Column Headers -->
            <Grid Grid.Row="2" ColumnDefinitions="32, 1.8*, 0.9*, 1.4*, 1.8*, 1.4*, 1*, 36" Margin="14,0,14,8">
                <Border Grid.ColumnSpan="8" BorderThickness="0,0,0,2" BorderBrush="#262D3D" Padding="0,0,0,6"/>
                <TextBlock Grid.Column="0" Text="Select" FontSize="11" FontWeight="SemiBold" Foreground="#8B95A5" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="Physical Key / Axis" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="Type" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="3" Text="Virtual Player Slot" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="4" Text="Channel" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="5" Text="Dead Zone" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="6" Text="Calibration" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>

            <!-- ROW 3: Collapsible Device Mapping Groups -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,4">
                <ItemsControl ItemsSource="{Binding GroupedMappings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:DeviceMappingGroup">
                            <Border Background="#121622" BorderBrush="#20283C" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10">
                                <Expander IsExpanded="{Binding IsExpanded}" 
                                          HorizontalAlignment="Stretch" 
                                          HorizontalContentAlignment="Stretch"
                                          Background="Transparent" 
                                          BorderThickness="0" 
                                          Padding="0">
                                    
                                    <Expander.Header>
                                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" HorizontalAlignment="Stretch" Margin="0,2">
                                            <Border Grid.Column="0" Background="#1E2B45" CornerRadius="5" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="🎮 DEVICE" FontSize="10" FontWeight="Bold" Foreground="#3E7BFA"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DeviceName}" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                                <Border Background="#1A202E" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding EntryCount, StringFormat='{}{0} Binds Active'}" FontSize="11" Foreground="#8B95A5"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Group Target Player Assignment -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <TextBlock Text="Assign to Player:" FontSize="11" Foreground="#8B95A5" VerticalAlignment="Center"/>
                                                <ComboBox ItemsSource="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).PlayerTargets}"
                                                          PlaceholderText="Select Player..."
                                                          Width="180"
                                                          CornerRadius="5"
                                                          Background="#10141E"
                                                          FontSize="11"
                                                          SelectionChanged="OnBulkTargetSelectionChanged">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="models:PlayerTargetOption">
                                                            <Grid ColumnDefinitions="Auto, *">
                                                                <Border Grid.Column="0" Background="{Binding BgColorHex}" BorderBrush="{Binding BorderColorHex}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                                    <TextBlock Text="{Binding ShortBadge}" FontSize="10" FontWeight="Bold" Foreground="{Binding TextColorHex}"/>
                                                                </Border>
                                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="11"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Button Content="Select All" 
                                                        Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).SelectAllInGroupCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="#161B26" Foreground="#BAC2DE" FontSize="10" Padding="6,4" CornerRadius="4"/>
                                                <Button Content="Deselect" 
                                                        Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).DeselectAllInGroupCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="#161B26" Foreground="#BAC2DE" FontSize="10" Padding="6,4" CornerRadius="4"/>
                                                <Button Content="🗑 Remove" 
                                                        Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).RemoveSelectedInGroupCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="#2A1B1F" BorderBrush="#552229" Foreground="#FFAAAA" FontSize="10" Padding="6,4" CornerRadius="4"/>
                                                <Button Content="+ Add Key" 
                                                        Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).AddMappingToDeviceCommand}"
                                                        CommandParameter="{Binding DeviceName}"
                                                        Background="#1F283C" BorderBrush="#3D4B6E" Foreground="White" FontSize="11" Padding="10,4" CornerRadius="5"/>
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>

                                    <ItemsControl ItemsSource="{Binding Entries}" HorizontalAlignment="Stretch" Margin="8,4,8,10">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:MappingEntry">
                                                <Grid ColumnDefinitions="32, 1.8*, 0.9*, 1.4*, 1.8*, 1.4*, 1*, 36" 
                                                      HorizontalAlignment="Stretch" 
                                                      Margin="0,3">
                                                    
                                                    <CheckBox Grid.Column="0" 
                                                              IsChecked="{Binding IsSelected}" 
                                                              HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>

                                                    <Button Grid.Column="1" 
                                                            Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).StartListeningCommand}"
                                                            CommandParameter="{Binding}"
                                                            HorizontalAlignment="Stretch" 
                                                            HorizontalContentAlignment="Stretch"
                                                            Margin="3,0" 
                                                            Padding="6,4"
                                                            Background="#1F283C"
                                                            BorderBrush="#3D4B6E"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                        <Grid ColumnDefinitions="Auto, *">
                                                            <Border Grid.Column="0" 
                                                                    x:DataType="converters:BadgeInfo"
                                                                    DataContext="{Binding SourceDisplayName, Converter={StaticResource ButtonBadgeConverter}}"
                                                                    IsVisible="{Binding HasBadge}"
                                                                    Background="{Binding Background}"
                                                                    BorderBrush="{Binding Border}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="10"
                                                                    Width="22" Height="22"
                                                                    Margin="0,0,8,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Glyph}" 
                                                                           Foreground="{Binding Foreground}"
                                                                           FontSize="12" 
                                                                           FontWeight="Bold" 
                                                                           HorizontalAlignment="Center" 
                                                                           VerticalAlignment="Center"/>
                                                            </Border>

                                                            <TextBlock Grid.Column="1" 
                                                                       Text="{Binding SourceDisplayName}" 
                                                                       VerticalAlignment="Center" 
                                                                       HorizontalAlignment="Left"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </Button>

                                                    <ComboBox Grid.Column="2" 
                                                              SelectedItem="{Binding SourceType}" 
                                                              HorizontalAlignment="Stretch" 
                                                              Margin="3,0" 
                                                              CornerRadius="6"
                                                              Background="#161B26">
                                                        <models:InputType>Axis</models:InputType>
                                                        <models:InputType>Button</models:InputType>
                                                    </ComboBox>

                                                    <!-- Player Target Dropdown -->
                                                    <ComboBox Grid.Column="3" 
                                                              ItemsSource="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).PlayerTargets}"
                                                              SelectedValue="{Binding TargetDeviceId}"
                                                              SelectedValueBinding="{Binding Id}"
                                                              HorizontalAlignment="Stretch" 
                                                              Margin="3,0" 
                                                              CornerRadius="6"
                                                              Background="#161B26">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:PlayerTargetOption">
                                                                <Grid ColumnDefinitions="Auto, *">
                                                                    <Border Grid.Column="0" Background="{Binding BgColorHex}" BorderBrush="{Binding BorderColorHex}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                                        <TextBlock Text="{Binding ShortBadge}" FontSize="10" FontWeight="Bold" Foreground="{Binding TextColorHex}"/>
                                                                    </Border>
                                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="11"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>

                                                    <ComboBox Grid.Column="4" 
                                                              ItemsSource="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).AvailableVirtualOutputs}"
                                                              SelectedItem="{Binding TargetOutput}" 
                                                              MaxDropDownHeight="300"
                                                              HorizontalAlignment="Stretch" 
                                                              Margin="3,0" 
                                                              CornerRadius="6"
                                                              Background="#161B26">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <Grid ColumnDefinitions="Auto, *" x:CompileBindings="False">
                                                                    <Border Grid.Column="0" 
                                                                            x:DataType="converters:BadgeInfo"
                                                                            DataContext="{Binding Converter={StaticResource ButtonBadgeConverter}}"
                                                                            IsVisible="{Binding HasBadge}"
                                                                            Background="{Binding Background}"
                                                                            BorderBrush="{Binding Border}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="10"
                                                                            Width="20" Height="20"
                                                                            Margin="0,0,8,0"
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Glyph}" 
                                                                                   Foreground="{Binding Foreground}"
                                                                                   FontSize="11" 
                                                                                   FontWeight="Bold" 
                                                                                   HorizontalAlignment="Center" 
                                                                                   VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <TextBlock Grid.Column="1" 
                                                                               Text="{Binding}" 
                                                                               VerticalAlignment="Center" 
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>

                                                    <Panel Grid.Column="5" Margin="4,0" HorizontalAlignment="Stretch">
                                                        <Grid ColumnDefinitions="*, 36" IsVisible="{Binding IsAxis}" HorizontalAlignment="Stretch">
                                                            <Slider Grid.Column="0" 
                                                                    Minimum="0.0" 
                                                                    Maximum="0.5" 
                                                                    Value="{Binding Deadzone}" 
                                                                    HorizontalAlignment="Stretch"
                                                                    VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" 
                                                                       Text="{Binding Deadzone, StringFormat='{}{0:P0}'}" 
                                                                       FontSize="11" 
                                                                       Foreground="#8B95A5" 
                                                                       VerticalAlignment="Center" 
                                                                       HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <TextBlock Text="—" 
                                                                   Foreground="#4B5563" 
                                                                   HorizontalAlignment="Center" 
                                                                   VerticalAlignment="Center" 
                                                                   IsVisible="{Binding !IsAxis}"/>
                                                    </Panel>

                                                    <Panel Grid.Column="6" Margin="3,0" HorizontalAlignment="Stretch">
                                                        <Button Content="Calibrate" 
                                                                Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).OpenCalibrationCommand}"
                                                                CommandParameter="{Binding}"
                                                                HorizontalAlignment="Stretch" 
                                                                HorizontalContentAlignment="Center"
                                                                Background="#1B2130"
                                                                BorderBrush="#2B354C"
                                                                CornerRadius="6"
                                                                IsVisible="{Binding IsAxis}"/>
                                                        <TextBlock Text="—" 
                                                                   Foreground="#4B5563" 
                                                                   HorizontalAlignment="Center" 
                                                                   VerticalAlignment="Center" 
                                                                   IsVisible="{Binding !IsAxis}"/>
                                                    </Panel>

                                                    <Button Grid.Column="7" 
                                                            Content="✕" 
                                                            Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).RemoveMappingCommand}"
                                                            CommandParameter="{Binding}"
                                                            HorizontalAlignment="Center" 
                                                            VerticalAlignment="Center"
                                                            Foreground="#FF5C5C" 
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            FontWeight="Bold"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ROW 4: Main Footer Controls -->
            <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="#262D3D" Padding="0,12,0,4">
                <StackPanel Spacing="12">
                    
                    <Grid ColumnDefinitions="*, Auto, *, Auto, *">
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="2">
                            <TextBlock Text="ACTIVE VIRTUAL TARGET" FontSize="10" FontWeight="Bold" Foreground="#8B95A5" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding VirtualDeviceSummary}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <Border Grid.Column="1" Width="1" Height="24" Background="#262D3D"/>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="2">
                            <TextBlock Text="MAPPING STATUS" FontSize="10" FontWeight="Bold" Foreground="#8B95A5" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding MappingStatus}" FontSize="14" FontWeight="SemiBold" Foreground="#00E599" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <Border Grid.Column="3" Width="1" Height="24" Background="#262D3D"/>

                        <StackPanel Grid.Column="4" HorizontalAlignment="Center" Spacing="2">
                            <TextBlock Text="POLL LATENCY" FontSize="10" FontWeight="Bold" Foreground="#8B95A5" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Latency}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="Auto, 140, Auto, Auto, *, Auto, 170">
                        <TextBlock Grid.Column="0" Text="Profile" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="#BAC2DE"/>
                        
                        <ComboBox Grid.Column="1" 
                                  ItemsSource="{Binding Profiles}"
                                  SelectedItem="{Binding SelectedProfile}"
                                  HorizontalAlignment="Stretch" 
                                  CornerRadius="6" 
                                  Background="#1B202E" 
                                  BorderBrush="#2F384C"/>

                        <Button Grid.Column="2" 
                                Content="+ New"
                                Command="{Binding OpenCreateProfileDialogCommand}"
                                Margin="6,0,0,0"
                                Padding="10,6"
                                CornerRadius="6"
                                Background="#232A3B"
                                BorderBrush="#3D4B6E"/>

                        <Button Grid.Column="3" 
                                Content="Save"
                                Command="{Binding SaveCurrentProfileCommand}"
                                Margin="6,0,0,0"
                                Padding="12,6"
                                FontWeight="SemiBold"
                                CornerRadius="6"
                                Background="#1A4A38"
                                BorderBrush="#266D53"/>

                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Button Content="Select All" Command="{Binding SelectAllMappingsCommand}" Background="#1F283C" Foreground="#BAC2DE" FontSize="11" Padding="8,6" CornerRadius="5"/>
                            <Button Content="Deselect" Command="{Binding DeselectAllMappingsCommand}" Background="#1F283C" Foreground="#BAC2DE" FontSize="11" Padding="8,6" CornerRadius="5"/>
                            <Button Content="🗑 Delete Selected" Command="{Binding RemoveSelectedMappingsCommand}" Background="#2A1B1F" BorderBrush="#552229" Foreground="#FFAAAA" FontSize="11" Padding="10,6" CornerRadius="5"/>
                        </StackPanel>

                        <Button Grid.Column="6" 
                                Command="{Binding AddMappingCommand}"
                                Content="+ Add Mapping" 
                                HorizontalAlignment="Stretch" 
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Height="38"
                                FontSize="13"
                                FontWeight="SemiBold"
                                CornerRadius="19" 
                                Background="#2A303F" 
                                Foreground="#FFFFFF" 
                                BorderBrush="#3D4559"
                                BorderThickness="1"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- UPDATE CONFIRMATION MODAL -->
        <Border IsVisible="{Binding IsUpdatePromptOpen}" Background="#CC0A0D14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="#121620" BorderBrush="#2D374D" BorderThickness="1" CornerRadius="12" Padding="24" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="Auto, *">
                        <TextBlock Grid.Column="0" Text="🚀" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="New Update Available!" FontWeight="Bold" FontSize="16" Foreground="White"/>
                            <TextBlock Text="{Binding NewVersionNumber, StringFormat='Version {0} is ready to download.'}" FontSize="12" Foreground="#8B95A5"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="A new version of ECCR is available. Would you like to update and restart now? The app will relaunch with the latest features." 
                               TextWrapping="Wrap" FontSize="13" Foreground="#D0D0E0"/>

                    <ProgressBar IsVisible="{Binding IsInstallingUpdate}" Value="{Binding UpdateDownloadProgress}" Maximum="100" Height="6" CornerRadius="3"/>
                    <TextBlock IsVisible="{Binding IsInstallingUpdate}" Text="{Binding UpdateStatusText}" FontSize="11" Foreground="#00E599" HorizontalAlignment="Center"/>

                    <Grid ColumnDefinitions="*, *" Margin="0,8,0,0">
                        <Button Grid.Column="0" Content="Later" Command="{Binding DismissUpdatePromptCommand}" 
                                IsEnabled="{Binding !IsInstallingUpdate}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,6,0" 
                                Background="#262D3D" Foreground="White" Padding="12,8" CornerRadius="6"/>
                        
                        <Button Grid.Column="1" Content="Update Now" Command="{Binding InstallUpdateAndRestartCommand}" 
                                IsEnabled="{Binding !IsInstallingUpdate}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="6,0,0,0" 
                                FontWeight="Bold" Background="#00B074" Foreground="White" Padding="12,8" CornerRadius="6"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- POST-UPDATE CONFIRMATION MODAL -->
        <Border IsVisible="{Binding IsPostUpdateOpen}" Background="#CC0A0D14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="#121620" BorderBrush="#2D374D" BorderThickness="1" CornerRadius="12" Padding="24" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="Auto, *">
                        <TextBlock Grid.Column="0" Text="🎉" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Update Successful!" FontWeight="Bold" FontSize="16" Foreground="White"/>
                            <TextBlock Text="{Binding PostUpdateMessage}" FontSize="13" Foreground="#00E599" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="ECCR has been updated to the latest build. Your profiles, device configurations, and calibrations are intact." 
                               TextWrapping="Wrap" FontSize="12" Foreground="#BAC2DE"/>

                    <Button Content="Close &amp; Continue" Command="{Binding DismissPostUpdateCommand}" 
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" 
                            FontWeight="SemiBold" Background="#3E7BFA" Foreground="White" Padding="14,8" CornerRadius="6"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- SETTINGS MODAL -->
        <Border IsVisible="{Binding IsSettingsOpen}" Background="#CC0A0D14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="#121620" BorderBrush="#2D374D" BorderThickness="1" CornerRadius="12" Padding="24" Width="720" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid RowDefinitions="Auto, *, Auto">
                    
                    <!-- Header -->
                    <Border Grid.Row="0" Background="#161B26" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Viewbox Grid.Column="0" Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Canvas Width="48" Height="48">
                                    <Ellipse Canvas.Left="2" Canvas.Top="2" Width="44" Height="44" Stroke="#3E7BFA" StrokeThickness="3.5" Fill="#121620"/>
                                    <Rectangle Canvas.Left="12" Canvas.Top="14" Width="24" Height="20" RadiusX="6" RadiusY="6" Fill="#1E2B45" Stroke="#00E599" StrokeThickness="1.5"/>
                                    <Rectangle Canvas.Left="16" Canvas.Top="21" Width="4" Height="6" Fill="#BAC2DE"/>
                                    <Rectangle Canvas.Left="15" Canvas.Top="22" Width="6" Height="4" Fill="#BAC2DE"/>
                                    <Ellipse Canvas.Left="28" Canvas.Top="20" Width="3" Height="3" Fill="#FF4D6D"/>
                                    <Ellipse Canvas.Left="26" Canvas.Top="23" Width="3" Height="3" Fill="#3E7BFA"/>
                                    <Ellipse Canvas.Left="30" Canvas.Top="23" Width="3" Height="3" Fill="#00E599"/>
                                    <Ellipse Canvas.Left="28" Canvas.Top="26" Width="3" Height="3" Fill="#FFB900"/>
                                </Canvas>
                            </Viewbox>

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="⚙️ Application Settings &amp; Modules" FontWeight="Bold" FontSize="16" Foreground="White"/>
                                <TextBlock Text="Configure startup preferences, drivers, Velopack updates, and app state." Foreground="#8B95A5" FontSize="11"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="✕" Command="{Binding CloseSettingsCommand}" Width="32" Height="32" CornerRadius="6" Background="#262D3D" Foreground="White"/>
                        </Grid>
                    </Border>

                    <!-- Scrollable Settings Body -->
                    <ScrollViewer Grid.Row="1" MaxHeight="450" Padding="0,0,8,0">
                        <StackPanel Spacing="14">
                            
                            <!-- 1. System Integration -->
                            <Border Background="#161B26" CornerRadius="8" Padding="14" BorderBrush="#20283C" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="System Integration &amp; Tray Behavior" FontWeight="Bold" FontSize="13" Foreground="#BAC2DE"/>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Run on Windows Startup" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                                            <TextBlock Text="Starts ECCR in the background when your computer boots up." FontSize="11" Foreground="#888899"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartWithWindows}" OnContent="Enabled" OffContent="Disabled"/>
                                    </Grid>
                                    <Border Height="1" Background="#1F283C" Margin="0,2"/>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Run in System Tray" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                                            <TextBlock Text="Keep ECCR active in the taskbar notification area." FontSize="11" Foreground="#888899"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding RunInSystemTray}" OnContent="Enabled" OffContent="Disabled"/>
                                    </Grid>
                                    <Border Height="1" Background="#1F283C" Margin="0,2"/>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Minimize to System Tray" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                                            <TextBlock Text="Hides the main window to the notification area when minimized." FontSize="11" Foreground="#888899"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTray}" OnContent="Enabled" OffContent="Disabled"/>
                                    </Grid>
                                    <Border Height="1" Background="#1F283C" Margin="0,2"/>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Closing Window Minimizes to Tray" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                                            <TextBlock Text="Clicking the 'X' button hides ECCR to tray instead of quitting." FontSize="11" Foreground="#888899"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CloseMinimizesToTray}" OnContent="Enabled" OffContent="Disabled"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 2. Driver & Module Lifecycle Management -->
                            <Border Background="#161B26" CornerRadius="8" Padding="14" BorderBrush="#20283C" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Grid.Column="0" Text="Driver &amp; System Module Management" FontWeight="Bold" FontSize="13" Foreground="#BAC2DE"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DriverInstallProgressText}" IsVisible="{Binding IsBusyWithDriverAction}" Foreground="#FFB84D" FontSize="11" FontWeight="SemiBold"/>
                                    </Grid>
                                    
                                    <!-- ViGEmBus Row -->
                                    <Grid ColumnDefinitions="*, Auto, Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="ViGEmBus (Virtual Controller Emulation)" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                                            <TextBlock Text="Required for Xbox 360 &amp; DualShock feeder output." FontSize="11" Foreground="#888899"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" 
                                                Content="{Binding IsViGEmInstalled, Converter={StaticResource BoolToRepairTextConverter}}" 
                                                Command="{Binding InstallDriverCommand}" CommandParameter="ViGEmBus" 
                                                IsEnabled="{Binding !IsBusyWithDriverAction}"
                                                Background="#1F283C" Foreground="White" FontSize="11" Margin="0,0,8,0" Padding="10,5" CornerRadius="5"/>
                                        <Button Grid.Column="2" 
                                                Content="Uninstall" 
                                                Command="{Binding UninstallDriverCommand}" CommandParameter="ViGEmBus"
                                                IsEnabled="{Binding IsViGEmInstalled}"
                                                Background="#2A1B1F" BorderBrush="#552229" Foreground="#FFAAAA" FontSize="11" Padding="10,5" CornerRadius="5"/>
                                    </Grid>
                                    
                                    <Border Height="1" Background="#1F283C" Margin="0,2"/>

                                    <!-- HidHide Row -->
                                    <Grid ColumnDefinitions="*, Auto, Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Nefarius HidHide (Device Cloaking Driver)" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                                            <TextBlock Text="Hides physical devices from games to prevent double-input bugs." FontSize="11" Foreground="#888899"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" 
                                                Content="{Binding IsHidHideServiceInstalled, Converter={StaticResource BoolToRepairTextConverter}}" 
                                                Command="{Binding InstallDriverCommand}" CommandParameter="HidHide" 
                                                IsEnabled="{Binding !IsBusyWithDriverAction}"
                                                Background="#1F283C" Foreground="White" FontSize="11" Margin="0,0,8,0" Padding="10,5" CornerRadius="5"/>
                                        <Button Grid.Column="2" 
                                                Content="Uninstall" 
                                                Command="{Binding UninstallDriverCommand}" CommandParameter="HidHide"
                                                IsEnabled="{Binding IsHidHideServiceInstalled}"
                                                Background="#2A1B1F" BorderBrush="#552229" Foreground="#FFAAAA" FontSize="11" Padding="10,5" CornerRadius="5"/>
                                    </Grid>

                                    <Border Height="1" Background="#1F283C" Margin="0,2"/>

                                    <!-- vJoy Row -->
                                    <Grid ColumnDefinitions="*, Auto, Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="vJoy (Virtual Joystick / DirectInput Axis Output)" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                                            <TextBlock Text="Required for DirectInput wheel splits and custom joystick output." FontSize="11" Foreground="#888899"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" 
                                                Content="{Binding IsVJoyInstalled, Converter={StaticResource BoolToRepairTextConverter}}" 
                                                Command="{Binding InstallDriverCommand}" CommandParameter="VJoy" 
                                                IsEnabled="{Binding !IsBusyWithDriverAction}"
                                                Background="#1F283C" Foreground="White" FontSize="11" Margin="0,0,8,0" Padding="10,5" CornerRadius="5"/>
                                        <Button Grid.Column="2" 
                                                Content="Uninstall" 
                                                Command="{Binding UninstallDriverCommand}" CommandParameter="VJoy"
                                                IsEnabled="{Binding IsVJoyInstalled}"
                                                Background="#2A1B1F" BorderBrush="#552229" Foreground="#FFAAAA" FontSize="11" Padding="10,5" CornerRadius="5"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 3. Velopack Updates -->
                            <Border Background="#161B26" CornerRadius="8" Padding="14" BorderBrush="#20283C" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Software Updates (Velopack)" FontWeight="Bold" FontSize="13" Foreground="#BAC2DE"/>
                                    
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Check for Updates on Startup" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                                            <TextBlock Text="Automatically look for newer versions when ECCR starts." FontSize="11" Foreground="#888899"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoCheckForUpdates}" OnContent="Enabled" OffContent="Disabled"/>
                                    </Grid>
                                    
                                    <Border Background="#10141E" CornerRadius="6" Padding="12" Margin="0,4,0,0" BorderBrush="#1F283C" BorderThickness="1">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock Text="{Binding UpdateStatusText}" FontWeight="SemiBold" FontSize="12" Foreground="#D0D0E0"/>
                                                <ProgressBar IsVisible="{Binding IsInstallingUpdate}" Value="{Binding UpdateDownloadProgress}" Maximum="100" Height="6" CornerRadius="3"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0">
                                                <Button Content="🔄 Check Now" Command="{Binding CheckForUpdatesManualCommand}" IsEnabled="{Binding !IsCheckingForUpdates}" Background="#1F283C" Foreground="White" FontSize="11" Padding="10,6" CornerRadius="5"/>
                                                <Button Content="⬇ Install &amp; Restart" Command="{Binding InstallUpdateAndRestartCommand}" IsVisible="{Binding IsUpdateAvailable}" IsEnabled="{Binding !IsInstallingUpdate}" Background="#00B074" Foreground="White" FontWeight="Bold" FontSize="11" Padding="12,6" CornerRadius="5"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 4. Factory Reset App State -->
                            <Border Background="#161B26" CornerRadius="8" Padding="14" BorderBrush="#3D2026" BorderThickness="1">
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Reset Application Settings &amp; Profiles" FontWeight="Bold" FontSize="13" Foreground="#FFAAAA"/>
                                        <TextBlock Text="Clears your settings.json and resets profiles back to defaults." FontSize="11" Foreground="#888899"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" 
                                            Content="Reset to Factory Defaults" 
                                            Command="{Binding ResetAllSettingsCommand}"
                                            Background="#331A20" BorderBrush="#772A38" BorderThickness="1" Foreground="#FFAAAA" 
                                            FontSize="11" FontWeight="SemiBold" Padding="14,6" CornerRadius="5"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- SETTINGS FOOTER -->
                    <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,14,0,0">
                        <TextBlock Grid.Column="0" 
                                   Text="{Binding DisplayVersionText}" 
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   Foreground="#70A0FF" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Left"/>
                        
                        <Button Grid.Column="1" 
                                Content="Done &amp; Save Preferences" 
                                Command="{Binding CloseSettingsCommand}" 
                                HorizontalAlignment="Right" 
                                Background="#00B074" 
                                Foreground="White" 
                                FontWeight="SemiBold" 
                                Padding="20,8" 
                                CornerRadius="6"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- HIDHIDE MODAL (see Views/HidHideView.axaml + ViewModels/HidHideViewModel.cs) -->
        <views:HidHideView DataContext="{Binding HidHide}"/>

        <!-- CREATE PROFILE MODAL -->
        <Border IsVisible="{Binding IsCreatingProfile}" Background="#CC0A0D14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="#161B26" BorderBrush="#2D374D" BorderThickness="1" CornerRadius="10" Padding="24" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="Create New Profile" FontSize="18" FontWeight="Bold"/>
                    <TextBox Text="{Binding CustomProfileInput}" Watermark="Enter profile name (e.g., Assetto Rig)" CornerRadius="6" Background="#0E1118" Padding="10,8"/>
                    <Grid ColumnDefinitions="*, *">
                        <Button Grid.Column="0" Content="Cancel" Command="{Binding CancelCreateProfileCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,6,0" Background="#262D3D" CornerRadius="6"/>
                        <Button Grid.Column="1" Content="Create &amp; Save" Command="{Binding ConfirmCreateProfileCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="6,0,0,0" FontWeight="SemiBold" Background="#00B074" CornerRadius="6"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>