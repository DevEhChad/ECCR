<!--
    App shell: a collapsible left sidebar (Views/SidebarView.axaml) + a persistent top
    device-status bar (Views/DeviceStatusBarView.axaml, visible on every page) + a content
    area that page-switches via a ContentControl bound to CurrentPageViewModel. Every page
    used to be a full-window IsVisible-toggled overlay Border layered directly in this file;
    they are now separate Views registered into MainWindowViewModel's _pageViewModels
    dictionary and resolved by ViewLocator (see App.axaml's Application.DataTemplates).

    Two exceptions stay as global overlay Borders here, unchanged from before, since they are
    unsolicited interruptions that should render on top of the whole shell regardless of which
    page is active: the Update-available prompt and the post-update Changelog popup (see
    MainWindowViewModel.CheckPostUpdateStatus). RootWindow's x:Name and DataContext are
    unchanged, which is what keeps every "#RootWindow.((vm:MainWindowViewModel)DataContext).X"
    compiled binding inside the migrated page Views resolving correctly.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ECCR.ViewModels"
        xmlns:models="using:ECCR.Models"
        xmlns:views="using:ECCR.Views"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="800"
        Width="1280"
        Height="800"
        MinWidth="800"
        MinHeight="600"
        x:Class="ECCR.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="RootWindow"
        Background="#0E1118"
        Foreground="White"
        Icon="/Assets/ECCR-logo.ico"
        Title="{Binding WindowTitle}"
        FontSize="14">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid>
        <Grid ColumnDefinitions="Auto, *">

            <!-- SIDEBAR (inherits MainWindow's DataContext - no explicit binding needed) -->
            <views:SidebarView Grid.Column="0"/>

            <!-- CONTENT COLUMN -->
            <Grid Grid.Column="1" RowDefinitions="Auto, Auto, *">

                <!-- Persistent device-status bar + global Virtual Devices toggle -->
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Background="#121622">
                    <views:DeviceStatusBarView Grid.Column="0" DataContext="{Binding StatusBar}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,16,0">
                        <ToggleSwitch IsChecked="{Binding IsVirtualOutputActive}"
                                      OnContent="Virtual Devices ON"
                                      OffContent="Virtual Devices OFF"
                                      FontSize="11"
                                      FontWeight="SemiBold"
                                      VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Dependency Banner (unchanged content, just re-hosted) -->
                <Border Grid.Row="1"
                        IsVisible="{Binding IsDependencyBannerOpen}"
                        Background="#241519"
                        BorderBrush="#552229"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,8"
                        Margin="16,10,16,0">
                    <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                        <TextBlock Grid.Column="0" Text="⚠️" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="System Driver Status &amp; Missing Services" FontWeight="Bold" FontSize="12" Foreground="#FFAAAA"/>
                            <WrapPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                    <TextBlock Text="ViGEmBus: " FontSize="11" Foreground="#888899"/>
                                    <TextBlock Text="Not Installed" Foreground="#FF6B6B" FontSize="11" FontWeight="SemiBold" IsVisible="{Binding !IsViGEmInstalled}"/>
                                    <TextBlock Text="Active" Foreground="#00E599" FontSize="11" FontWeight="SemiBold" IsVisible="{Binding IsViGEmInstalled}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                    <TextBlock Text="HidHide: " FontSize="11" Foreground="#888899"/>
                                    <TextBlock Text="Not Installed" Foreground="#FF6B6B" FontSize="11" FontWeight="SemiBold" IsVisible="{Binding !IsHidHideServiceInstalled}"/>
                                    <TextBlock Text="Active" Foreground="#00E599" FontSize="11" FontWeight="SemiBold" IsVisible="{Binding IsHidHideServiceInstalled}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="vJoy: " FontSize="11" Foreground="#888899"/>
                                    <TextBlock Text="Not Installed" Foreground="#FF6B6B" FontSize="11" FontWeight="SemiBold" IsVisible="{Binding !IsVJoyInstalled}"/>
                                    <TextBlock Text="Active" Foreground="#00E599" FontSize="11" FontWeight="SemiBold" IsVisible="{Binding IsVJoyInstalled}"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="10,0">
                            <Button Content="+ Install ViGEm" Command="{Binding InstallViGEmCommand}"
                                    IsVisible="{Binding !IsViGEmInstalled}" IsEnabled="{Binding !IsBusyWithDriverAction}"
                                    Background="#3E7BFA" Foreground="White" FontSize="11" Padding="8,4" CornerRadius="4"/>
                            <Button Content="+ Install HidHide" Command="{Binding InstallHidHideCommand}"
                                    IsVisible="{Binding !IsHidHideServiceInstalled}" IsEnabled="{Binding !IsBusyWithDriverAction}"
                                    Background="#7A3EFA" Foreground="White" FontSize="11" Padding="8,4" CornerRadius="4"/>
                            <Button Content="+ Install vJoy" Command="{Binding InstallVJoyCommand}"
                                    IsVisible="{Binding !IsVJoyInstalled}" IsEnabled="{Binding !IsBusyWithDriverAction}"
                                    Background="#00B074" Foreground="White" FontSize="11" Padding="8,4" CornerRadius="4"/>
                        </StackPanel>

                        <Button Grid.Column="3" Content="✕" Command="{Binding DismissDependencyBannerCommand}"
                                Background="Transparent" Foreground="#FFAAAA" Padding="6,2" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- PAGE CONTENT -->
                <ContentControl Grid.Row="2" Content="{Binding CurrentPageViewModel}"/>
            </Grid>
        </Grid>

        <!-- UPDATE CONFIRMATION MODAL: unsolicited startup interruption, stays global -->
        <Border IsVisible="{Binding IsUpdatePromptOpen}" Background="#CC0A0D14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="#121620" BorderBrush="#2D374D" BorderThickness="1" CornerRadius="12" Padding="24" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="Auto, *">
                        <TextBlock Grid.Column="0" Text="🚀" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="New Update Available!" FontWeight="Bold" FontSize="16" Foreground="White"/>
                            <TextBlock Text="{Binding NewVersionNumber, StringFormat='Version {0} is ready to download.'}" FontSize="12" Foreground="#8B95A5"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="A new version of ECCR is available. Would you like to update and restart now? The app will relaunch with the latest features."
                               TextWrapping="Wrap" FontSize="13" Foreground="#D0D0E0"/>

                    <ProgressBar IsVisible="{Binding IsInstallingUpdate}" Value="{Binding UpdateDownloadProgress}" Maximum="100" Height="6" CornerRadius="3"/>
                    <TextBlock IsVisible="{Binding IsInstallingUpdate}" Text="{Binding UpdateStatusText}" FontSize="11" Foreground="#00E599" HorizontalAlignment="Center"/>

                    <Grid ColumnDefinitions="*, *" Margin="0,8,0,0">
                        <Button Grid.Column="0" Content="Later" Command="{Binding DismissUpdatePromptCommand}"
                                IsEnabled="{Binding !IsInstallingUpdate}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,6,0"
                                Background="#262D3D" Foreground="White" Padding="12,8" CornerRadius="6"/>

                        <Button Grid.Column="1" Content="Update Now" Command="{Binding InstallUpdateAndRestartCommand}"
                                IsEnabled="{Binding !IsInstallingUpdate}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="6,0,0,0"
                                FontWeight="Bold" Background="#00B074" Foreground="White" Padding="12,8" CornerRadius="6"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- CHANGELOG MODAL: auto-shown scoped to the new version right after an update
             (if ShowChangelogOnUpdate is on, see MainWindowViewModel.CheckPostUpdateStatus),
             and opened showing the full history on demand from Settings > Software Updates.
             Independent of the About page's own current-version-only changelog view. -->
        <Border IsVisible="{Binding IsChangelogOpen}" Background="#CC0A0D14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="#121620" BorderBrush="#2D374D" BorderThickness="1" CornerRadius="12" Padding="22" Width="620" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid RowDefinitions="Auto, *, Auto">
                    <!-- Header -->
                    <Border Grid.Row="0" Background="#161B26" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <TextBlock Grid.Column="0" Text="📋" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Changelog" FontWeight="Bold" FontSize="16" Foreground="White"/>
                                <TextBlock Text="{Binding ChangelogSubtitle}" FontSize="12" Foreground="#00E599" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="✕" Command="{Binding CloseChangelogCommand}" Width="32" Height="32" CornerRadius="6" Background="#262D3D" Foreground="White"/>
                        </Grid>
                    </Border>

                    <!-- Scrollable body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ChangelogEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ChangelogBlock">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Text}" IsVisible="{Binding IsVersionHeader}"
                                                   FontWeight="Bold" FontSize="15" Foreground="#70A0FF" Margin="0,14,0,4" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Text}" IsVisible="{Binding IsSectionHeader}"
                                                   FontWeight="Bold" FontSize="13" Foreground="#BAC2DE" Margin="0,8,0,4" TextWrapping="Wrap"/>
                                        <TextBlock IsVisible="{Binding IsBullet}" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="#D0D0E0" Margin="10,2,0,2" x:CompileBindings="False">
                                            <Run Text="•  "/><Bold><Run Text="{Binding BoldLead}"/></Bold><Run Text=" "/><Run Text="{Binding Rest}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Text}" IsVisible="{Binding IsPlain}"
                                                   TextWrapping="Wrap" FontSize="12" Foreground="#8B95A5" Margin="0,2,0,2"/>
                                        <Border IsVisible="{Binding IsDivider}" Height="1" Background="#1F283C" Margin="0,10"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto" Margin="0,14,0,0">
                        <Button Grid.Column="0" Content="🔗 View on GitHub" Command="{Binding OpenChangelogOnGitHubCommand}"
                                Background="#1F283C" Foreground="#70A0FF" Padding="12,8" CornerRadius="6" FontSize="12"/>
                        <Button Grid.Column="2" Content="Close" Command="{Binding CloseChangelogCommand}"
                                Background="#00B074" Foreground="White" FontWeight="SemiBold" Padding="20,8" CornerRadius="6"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- Global version stamp, visible bottom-right on every page -->
        <TextBlock Text="{Binding AppVersion}"
                   FontSize="11"
                   Foreground="#5A6478"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,14,8"
                   IsHitTestVisible="False"/>
    </Grid>
</Window>
