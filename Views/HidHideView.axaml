<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ECCR.ViewModels"
             xmlns:services="using:ECCR.Services"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="700"
             x:Class="ECCR.Views.HidHideView"
             x:DataType="vm:HidHideViewModel"
             x:Name="HidHideRoot">

    <!--
        HidHide page (formerly an in-window overlay modal - see MainWindow's doc comment
        history; now a full sidebar page). DataContext is still HidHideViewModel directly, so
        it's registered as-is into MainWindowViewModel's _pageViewModels (no separate page VM
        needed) and resolved by ViewLocator's naming convention like every other page. Same
        "#HidHideRoot.((vm:HidHideViewModel)DataContext).X" compiled-binding pattern
        MainWindow.axaml uses for its own name, needed here because the device/app list rows
        below are rendered via DataTemplates whose own DataContext is the row item.
    -->

    <Design.DataContext>
        <vm:HidHideViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *, Auto" Margin="24">
        <Border Grid.Row="0" Background="#161B26" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="🛡️ HidHide Device Cloaking &amp; Application Rules" FontWeight="Bold" FontSize="16" Foreground="White"/>
                    <TextBlock Text="Hide physical hardware to eliminate double inputs. Whitelist games to bypass cloaking." Foreground="#8B95A5" FontSize="12"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsHidHideActive}" OnContent="Cloaking Active" OffContent="Disabled"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*, 14, *">
            <Border Grid.Column="0" Background="#161B26" CornerRadius="8" Padding="12">
                <Grid RowDefinitions="Auto, Auto, *">
                    <TextBlock Grid.Row="0" Text="1. Physical Hardware to Cloak" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Grid Grid.Row="1" ColumnDefinitions="Auto, Auto, *" Margin="0,0,0,8">
                        <Button Grid.Column="0" Content="Cloak All" Command="{Binding SelectAllHidDevicesCommand}" Padding="10,4" FontSize="11"/>
                        <Button Grid.Column="1" Content="Uncloak All" Command="{Binding DeselectAllHidDevicesCommand}" Margin="6,0,0,0" Padding="10,4" FontSize="11"/>
                    </Grid>
                    <ScrollViewer Grid.Row="2">
                        <ItemsControl ItemsSource="{Binding HidDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:HidDeviceItem">
                                    <Border Background="#121620" CornerRadius="6" Padding="8" Margin="0,2">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding FriendlyName}" VerticalAlignment="Center"/>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding IsHidden}"
                                                      Command="{Binding #HidHideRoot.((vm:HidHideViewModel)DataContext).ToggleHidDeviceCommand}"
                                                      CommandParameter="{Binding}" Content="Hide"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#161B26" CornerRadius="8" Padding="12">
                <Grid RowDefinitions="Auto, Auto, *">
                    <TextBlock Grid.Row="0" Text="2. Whitelisted Applications" FontWeight="Bold" Margin="0,0,0,8"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                        <Button Content="+ Add Game (.exe)" Command="{Binding AddApplicationToHidHideCommand}" CommandParameter="{Binding $parent[Window].StorageProvider}" FontSize="11"/>
                        <Button Content="Clear All" Command="{Binding ClearAllApplicationsFromHidHideCommand}" FontSize="11"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="2">
                        <ItemsControl ItemsSource="{Binding WhitelistedApplications}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Background="#121620" CornerRadius="6" Padding="6" Margin="0,2">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="✕" Command="{Binding #HidHideRoot.((vm:HidHideViewModel)DataContext).RemoveApplicationFromHidHideCommand}" CommandParameter="{Binding}" Foreground="#FF6666" Background="Transparent"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Button Content="Apply &amp; Done" Command="{Binding CloseHidHideMenuCommand}" HorizontalAlignment="Right" Background="#00B074" FontWeight="SemiBold" Padding="20,6" CornerRadius="6"/>
        </Grid>
    </Grid>
</UserControl>
