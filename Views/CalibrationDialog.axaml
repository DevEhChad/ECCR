<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:ECCR.Models"
        x:Class="ECCR.Views.CalibrationDialog"
        x:DataType="models:MappingEntry"
        Title="Axis Calibration"
        Width="540" Height="580"
        WindowStartupLocation="CenterOwner"
        Background="#0E1118"
        Foreground="White"
        CanResize="false">

    <Grid RowDefinitions="Auto, *, Auto" Margin="22">
        <!-- Header -->
        <Border Grid.Row="0" Background="#161B26" CornerRadius="8" Padding="14" Margin="0,0,0,14" BorderBrush="#20283C" BorderThickness="1">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="🎯 Advanced Axis Calibration" FontWeight="Bold" FontSize="16" Foreground="White"/>
                    <TextBlock Text="{Binding SourceDisplayName, StringFormat='Calibrating: {0}'}" FontSize="12" Foreground="#8B95A5"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#10141E" CornerRadius="6" Padding="10,4" BorderBrush="#1F283C" BorderThickness="1">
                    <TextBlock Text="{Binding LatestRawReading, StringFormat='Live Raw: {0}'}" FontSize="12" Foreground="#00E599" FontWeight="Bold" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Calibration Controls -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                
                <!-- Live Bar Visualizers -->
                <Border Background="#161B26" CornerRadius="8" Padding="14" BorderBrush="#20283C" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="Raw DirectInput Signal" FontWeight="SemiBold" FontSize="12" Foreground="#BAC2DE"/>
                            <TextBlock Grid.Column="1" Text="{Binding LiveRawPercentage, StringFormat='{}{0:P0}'}" FontSize="11" Foreground="#8B95A5"/>
                        </Grid>
                        <ProgressBar Value="{Binding LiveRawPercentage}" Maximum="1.0" Height="8" CornerRadius="4" Foreground="#3E7BFA"/>

                        <Border Height="1" Background="#1F283C" Margin="0,4"/>

                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="Calibrated Output Signal" FontWeight="SemiBold" FontSize="12" Foreground="#BAC2DE"/>
                            <TextBlock Grid.Column="1" Text="{Binding LiveOutputPercentage, StringFormat='{}{0:P0}'}" FontSize="12" Foreground="#00E599" FontWeight="Bold"/>
                        </Grid>
                        <ProgressBar Value="{Binding LiveOutputPercentage}" Maximum="1.0" Height="10" CornerRadius="5" Foreground="#00E599"/>
                    </StackPanel>
                </Border>

                <!-- Calibration Range Set Points (Min / Center / Max) -->
                <Border Background="#161B26" CornerRadius="8" Padding="14" BorderBrush="#20283C" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Calibration Range Points" FontWeight="Bold" FontSize="13" Foreground="#BAC2DE"/>
                        
                        <Grid ColumnDefinitions="*, *, *">
                            <!-- Min Point -->
                            <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,4,0">
                                <TextBlock Text="Minimum Point" FontSize="11" Foreground="#8B95A5" HorizontalAlignment="Center"/>
                                <Border Background="#10141E" CornerRadius="6" Padding="8,4" HorizontalAlignment="Stretch">
                                    <TextBlock Text="{Binding RawMin}" FontWeight="Bold" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
                                </Border>
                                <Button Content="Set Min" Click="OnSetMinClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#1F283C" Foreground="White" FontSize="11" Padding="8,5" CornerRadius="5"/>
                            </StackPanel>

                            <!-- Center Point -->
                            <StackPanel Grid.Column="1" Spacing="6" Margin="2,0,2,0">
                                <TextBlock Text="Center Point" FontSize="11" Foreground="#8B95A5" HorizontalAlignment="Center"/>
                                <Border Background="#10141E" CornerRadius="6" Padding="8,4" HorizontalAlignment="Stretch">
                                    <TextBlock Text="{Binding RawCenter}" FontWeight="Bold" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
                                </Border>
                                <Button Content="Set Center" Click="OnSetCenterClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#1F283C" Foreground="White" FontSize="11" Padding="8,5" CornerRadius="5"/>
                            </StackPanel>

                            <!-- Max Point -->
                            <StackPanel Grid.Column="2" Spacing="6" Margin="4,0,0,0">
                                <TextBlock Text="Maximum Point" FontSize="11" Foreground="#8B95A5" HorizontalAlignment="Center"/>
                                <Border Background="#10141E" CornerRadius="6" Padding="8,4" HorizontalAlignment="Stretch">
                                    <TextBlock Text="{Binding RawMax}" FontWeight="Bold" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
                                </Border>
                                <Button Content="Set Max" Click="OnSetMaxClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#1F283C" Foreground="White" FontSize="11" Padding="8,5" CornerRadius="5"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Deadzone & Invert -->
                <Border Background="#161B26" CornerRadius="8" Padding="14" BorderBrush="#20283C" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*, 40">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Dead Zone" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                                <TextBlock Text="Eliminates input jitter near resting position." FontSize="11" Foreground="#888899"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Deadzone, StringFormat='{}{0:P0}'}" FontWeight="Bold" FontSize="12" Foreground="#00E599" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider Minimum="0.0" Maximum="0.5" Value="{Binding Deadzone}" HorizontalAlignment="Stretch"/>

                        <Border Height="1" Background="#1F283C" Margin="0,2"/>

                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Invert Axis Direction" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                                <TextBlock Text="Reverse output direction (useful for inverted pedals or flight sticks)." FontSize="11" Foreground="#888899"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsInverted}" OnContent="Inverted" OffContent="Normal"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto" Margin="0,14,0,0">
            <Button Grid.Column="0" Content="↺ Reset Calibration" Click="OnResetClick" Background="#2A1B1F" BorderBrush="#552229" Foreground="#FFAAAA" Padding="14,8" CornerRadius="6" FontSize="12"/>
            <Button Grid.Column="2" Content="Done &amp; Save" Click="OnDoneClick" Background="#00B074" Foreground="White" FontWeight="Bold" Padding="24,8" CornerRadius="6" FontSize="12"/>
        </Grid>
    </Grid>
</Window>