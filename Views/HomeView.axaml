<!-- Home dashboard: hero banner + device summary + quick-action cards. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ECCR.ViewModels"
             xmlns:models="using:ECCR.Models"
             xmlns:avc="using:Avalonia.Data.Converters"
             xmlns:converters="using:ECCR.Converters"
             mc:Ignorable="d"
             d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="ECCR.Views.HomeView"
             x:DataType="vm:HomeViewModel"
             x:Name="HomeRoot">

    <UserControl.Resources>
        <converters:CategoryToGlyphConverter x:Key="CategoryToGlyphConverter"/>
    </UserControl.Resources>

    <Design.DataContext>
        <vm:HomeViewModel/>
    </Design.DataContext>

    <ScrollViewer Margin="32">
        <StackPanel Spacing="24" MaxWidth="1200" HorizontalAlignment="Stretch">

            <!-- Hero banner -->
            <Border CornerRadius="14" Height="200" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#1A2E4C" Offset="0"/>
                        <GradientStop Color="#0E1118" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnDefinitions="Auto, *" Margin="32">
                    <Border Grid.Column="0" Background="#121622" BorderBrush="#3E7BFA" BorderThickness="2" CornerRadius="20" Width="84" Height="84" VerticalAlignment="Center" Margin="0,0,22,0">
                        <Image Source="avares://ECCR/Assets/UILogos/Full-ControllerLogo.png" Width="52" Height="52"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"
                               RenderOptions.BitmapInterpolationMode="HighQuality"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <TextBlock Text="ECCR" FontWeight="Bold" FontSize="34" Foreground="White"/>
                        <TextBlock Text="Your rig, your rules." FontSize="16" Foreground="#8B95A5"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Device summary -->
            <Border Classes="card" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Connected Devices" FontWeight="Bold" FontSize="16" Foreground="#BAC2DE"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding StatusBar.AllDeviceStatuses}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="12"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ControllerStatus">
                                    <Button Classes="pillButton" Padding="14,8"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateToDeviceMappingCommand}"
                                            CommandParameter="{Binding DeviceInstanceName}"
                                            ToolTip.Tip="Open mapping for this device">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Image Source="{Binding Category, Converter={StaticResource CategoryToGlyphConverter}}"
                                                   Width="18" Height="18" Stretch="Uniform"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality"
                                                   VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DeviceInstanceName}" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="No devices connected." FontSize="14" Foreground="#4B5563" IsVisible="{Binding !StatusBar.HasDevices}"/>
                </StackPanel>
            </Border>

            <!-- Quick action cards -->
            <TextBlock Text="Quick Actions" FontWeight="Bold" FontSize="16" Foreground="#BAC2DE" Margin="0,4,0,0"/>
            <ItemsControl ItemsSource="{Binding QuickActionCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:NavItem">
                        <Button Classes="neutral" Width="360" Height="112" Margin="0,0,16,16"
                                Command="{Binding #HomeRoot.((vm:HomeViewModel)DataContext).NavigateToCommand}"
                                CommandParameter="{Binding Page}">
                            <Grid ColumnDefinitions="Auto, *">
                                <Image Grid.Column="0" Source="{Binding IconImage}" Width="32" Height="32" Stretch="Uniform"
                                       VerticalAlignment="Center" Margin="6,0,18,0" RenderOptions.BitmapInterpolationMode="HighQuality"
                                       IsVisible="{Binding IconImage, Converter={x:Static avc:ObjectConverters.IsNotNull}}"/>
                                <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontSize="30" VerticalAlignment="Center" Margin="6,0,18,0"
                                           IsVisible="{Binding IconImage, Converter={x:Static avc:ObjectConverters.IsNull}}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="17" Foreground="White"/>
                                    <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#8B95A5" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
