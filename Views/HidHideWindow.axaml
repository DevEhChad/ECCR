<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ECCR.ViewModels"
             x:DataType="vm:MainWindowViewModel"
             x:Class="ECCR.Views.HidHideWindow">

    <Border Background="#16161A" CornerRadius="12" Padding="24" Width="900" Height="580"
            BorderBrush="#2B2B36" BorderThickness="1">
        <Grid RowDefinitions="Auto, *, Auto">

            <!-- Top Header & Master Toggle -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="🛡️ HidHide Device Isolation &amp; App Rules" 
                               FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Cloak secondary sim hardware to eliminate double-input conflicts in select games."
                               FontSize="12" Foreground="#888899" Margin="0,2,0,0"/>
                </StackPanel>

                <ToggleSwitch Grid.Column="1" 
                              IsChecked="{Binding IsHidHideActive}"
                              OnContent="Active" 
                              OffContent="Disabled"
                              Foreground="White"/>
            </Grid>

            <!-- Main Side-by-Side Content Grid -->
            <Grid Grid.Row="1" ColumnDefinitions="*, 16, *">

                <!-- LEFT PANEL: Detected Game Controllers & Sim Gear -->
                <Border Grid.Column="0" Background="#1E1E24" CornerRadius="8" Padding="14" BorderBrush="#262630" BorderThickness="1">
                    <Grid RowDefinitions="Auto, Auto, *">
                        <TextBlock Grid.Row="0" Text="1. Physical Hardware to Cloak" FontWeight="Bold" FontSize="14" Foreground="#E0E0E0"/>
                        <TextBlock Grid.Row="1" Text="Check devices you want hidden from un-whitelisted games." FontSize="11" Foreground="#888899" Margin="0,2,0,10"/>

                        <ListBox Grid.Row="2" ItemsSource="{Binding HidDevices}" Background="#121215" CornerRadius="6">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto, *" Margin="6,4">
                                        <CheckBox IsChecked="{Binding IsHidden}" 
                                                  Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ToggleHidDeviceCommand}"
                                                  CommandParameter="{Binding .}"
                                                  Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Manufacturer}" FontSize="11" Foreground="#6C7086"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- RIGHT PANEL: Applications / Games Exemption Rules -->
                <Border Grid.Column="2" Background="#1E1E24" CornerRadius="8" Padding="14" BorderBrush="#262630" BorderThickness="1">
                    <Grid RowDefinitions="Auto, Auto, Auto, *">
                        <TextBlock Grid.Row="0" Text="2. Application Target Rules" FontWeight="Bold" FontSize="14" Foreground="#E0E0E0"/>
                        <TextBlock Grid.Row="1" Text="Configure which games can see your physical devices." FontSize="11" Foreground="#888899" Margin="0,2,0,10"/>

                        <!-- Mode Filter Switcher -->
                        <Border Grid.Row="2" Background="#262630" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Whitelist Mode (Recommended)" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                                    <TextBlock Text="Only added games (e.g. Assetto Corsa) see real devices." FontSize="10" Foreground="#AAAABB"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" 
                                              IsChecked="{Binding IsAppListInverted}"
                                              OnContent="Blacklist" 
                                              OffContent="Whitelist"
                                              Foreground="White"/>
                            </Grid>
                        </Border>

                        <!-- App Buttons & List -->
                        <Grid Grid.Row="3" RowDefinitions="Auto, *">
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                                <Button Content="+ Add Game (.exe)" 
                                        Command="{Binding AddApplicationToHidHideCommand}" 
                                        CommandParameter="{Binding $parent[TopLevel].StorageProvider}"
                                        Background="#3A3F58" Foreground="White" FontSize="11" Padding="8,4"/>
                                <Button Content="+ Add Folder" 
                                        Command="{Binding AddDirectoryToHidHideCommand}" 
                                        CommandParameter="{Binding $parent[TopLevel].StorageProvider}"
                                        Background="#3A3F58" Foreground="White" FontSize="11" Padding="8,4"/>
                                <Button Content="Clear" 
                                        Command="{Binding ClearAllApplicationsFromHidHideCommand}" 
                                        Background="#442222" Foreground="#FFAAAA" FontSize="11" Padding="8,4"/>
                            </StackPanel>

                            <ListBox Grid.Row="1" ItemsSource="{Binding WhitelistedApplications}" Background="#121215" CornerRadius="6">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*, Auto" Margin="4">
                                            <TextBlock Text="{Binding .}" Foreground="#D0D0E0" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="1" Content="✕" 
                                                    Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).RemoveApplicationFromHidHideCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Background="Transparent" Foreground="#FF6666" Padding="6,2" FontSize="10"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>

            </Grid>

            <!-- Bottom Action Footer -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto, *" Margin="0,16,0,0">
                <Button Content="🔄 Refresh Devices" Command="{Binding RefreshHidDevices}" Background="#2B2B36" Foreground="White" Padding="12,6"/>
                <Button Grid.Column="1" Content="Done" Command="{Binding CloseHidHideMenuCommand}" HorizontalAlignment="Right" Background="#007ACC" Foreground="White" Padding="24,6"/>
            </Grid>

        </Grid>
    </Border>
</UserControl>