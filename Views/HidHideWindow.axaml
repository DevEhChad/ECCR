<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ECCR.ViewModels"
        x:Class="ECCR.Views.HidHideWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="HidHide Device Cloaking"
        Width="900" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="#0E1118"
        Foreground="White">
    <Grid Margin="20">
        <TextBlock Text="HidHide Embedded Manager" FontSize="18" FontWeight="Bold"/>
    </Grid>
</Window>