<!-- About page: current-version changelog + a website/repo link row, DSX-style (icon + title + description + right-aligned button). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ECCR.ViewModels"
             xmlns:models="using:ECCR.Models"
             mc:Ignorable="d"
             d:DesignWidth="800" d:DesignHeight="700"
             x:Class="ECCR.Views.AboutView"
             x:DataType="vm:AboutViewModel">

    <Design.DataContext>
        <vm:AboutViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, Auto, *" Margin="24">
        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,16">
            <TextBlock Text="ℹ️ About" FontWeight="Bold" FontSize="18" Foreground="White"/>
            <TextBlock Text="{Binding VersionSubtitle}" FontSize="12" Foreground="#8B95A5"/>
        </StackPanel>

        <!-- Website link row -->
        <Border Grid.Row="1" Classes="card" Margin="0,0,0,14" MaxWidth="760" HorizontalAlignment="Center">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <TextBlock Grid.Column="0" Text="🔗" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="ECCR on GitHub" FontWeight="Bold" FontSize="13" Foreground="White"/>
                    <TextBlock Text="Visit the repository for releases, issues, and the latest information." FontSize="11" Foreground="#8B95A5"/>
                </StackPanel>
                <Button Grid.Column="2" Content="🔗 Open on GitHub" Command="{Binding OpenWebsiteCommand}"
                        Background="#1F283C" Foreground="#70A0FF" Padding="12,8" CornerRadius="6" FontSize="12"/>
            </Grid>
        </Border>

        <!-- Current-version changelog -->
        <Border Grid.Row="2" Classes="card" MaxWidth="760" HorizontalAlignment="Center">
            <Grid RowDefinitions="Auto, *">
                <TextBlock Grid.Row="0" Text="What's New" FontWeight="Bold" FontSize="14" Foreground="White" Margin="0,0,0,10"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CurrentVersionEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ChangelogBlock">
                                <StackPanel>
                                    <TextBlock Text="{Binding Text}" IsVisible="{Binding IsVersionHeader}"
                                               FontWeight="Bold" FontSize="15" Foreground="#70A0FF" Margin="0,14,0,4" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Text}" IsVisible="{Binding IsSectionHeader}"
                                               FontWeight="Bold" FontSize="13" Foreground="#BAC2DE" Margin="0,8,0,4" TextWrapping="Wrap"/>
                                    <TextBlock IsVisible="{Binding IsBullet}" TextWrapping="Wrap" FontSize="12"
                                               Foreground="#D0D0E0" Margin="10,2,0,2" x:CompileBindings="False">
                                        <Run Text="•  "/><Bold><Run Text="{Binding BoldLead}"/></Bold><Run Text=" "/><Run Text="{Binding Rest}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Text}" IsVisible="{Binding IsPlain}"
                                               TextWrapping="Wrap" FontSize="12" Foreground="#8B95A5" Margin="0,2,0,2"/>
                                    <Border IsVisible="{Binding IsDivider}" Height="1" Background="#1F283C" Margin="0,10"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
