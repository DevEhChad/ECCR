<!--
    Device Mapping (Direct Input/Wheels) page: the same per-input binding grid as
    ControllerMappingView, filtered to wheel/pedal-class devices (ItemsSource = GroupEntries =
    MainWindowViewModel.WheelGroupedMappings), plus a Wheel Settings tab for the whole-wheel
    tuning ControllerMappingView has no equivalent of (rotation, force feedback strength/effect
    toggles/invert - see WheelDeviceSettings). See ControllerMappingView.axaml's doc comment for
    the shared tab-strip/device-picker pattern this follows.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ECCR.ViewModels"
             xmlns:models="using:ECCR.Models"
             xmlns:shared="using:ECCR.Views.Shared"
             mc:Ignorable="d"
             d:DesignWidth="1000" d:DesignHeight="760"
             x:Class="ECCR.Views.DeviceMappingView"
             x:DataType="vm:DeviceMappingViewModel">

    <Design.DataContext>
        <vm:DeviceMappingViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, Auto, Auto, *" Margin="16,10">
        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,10">
            <TextBlock Text="🛞 Device Mapping" FontWeight="Bold" FontSize="18" Foreground="White"/>
            <TextBlock Text="Bind axes and buttons for Direct Input wheels, pedals, and shifters." FontSize="12" Foreground="#8B95A5"/>
            <Border Background="#161B26" BorderBrush="#2B354C" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,6,0,0">
                <TextBlock FontSize="11" Foreground="#8B95A5" TextWrapping="Wrap">
                    <Run Text="💡" />
                    <Run Text="Click any binding, then press a button or move an axis to capture it - you have 7 seconds. "/>
                    <Run Text="Esc" FontWeight="Bold" Foreground="#D0D0E0"/>
                    <Run Text=" cancels, "/>
                    <Run Text="Backspace" FontWeight="Bold" Foreground="#D0D0E0"/>
                    <Run Text=" clears the binding."/>
                </TextBlock>
            </Border>
        </StackPanel>

        <!-- Device picker: scopes the Wheel Settings tab -->
        <Border Grid.Row="1" Classes="card" Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto, *">
                <TextBlock Grid.Column="0" Text="Device" FontWeight="SemiBold" FontSize="12" Foreground="#BAC2DE" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding GroupEntries}"
                          SelectedValue="{Binding SelectedDeviceName}"
                          SelectedValueBinding="{Binding DeviceName}"
                          HorizontalAlignment="Stretch"
                          CornerRadius="6"
                          Background="#10141E">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:DeviceMappingGroup">
                            <TextBlock Text="{Binding DeviceName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </Border>

        <!-- Tab strip -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Classes="mappingTab" Classes.mappingTabSelected="{Binding IsButtonMappingTabSelected}"
                    Command="{Binding SelectTabCommand}" CommandParameter="{x:Static models:DeviceMappingTab.ButtonMapping}"
                    Content="Button Mapping"/>
            <Button Classes="mappingTab" Classes.mappingTabSelected="{Binding IsWheelSettingsTabSelected}"
                    Command="{Binding SelectTabCommand}" CommandParameter="{x:Static models:DeviceMappingTab.WheelSettings}"
                    Content="Wheel Settings"/>
        </StackPanel>

        <!-- Tab content -->
        <Panel Grid.Row="3">

            <!-- Button Mapping: today's full grouped list across all devices, unaffected by the
                 device picker above. -->
            <Grid RowDefinitions="Auto, Auto, *" IsVisible="{Binding IsButtonMappingTabSelected}">
                <Button Grid.Row="0" Content="+ New Binding" HorizontalAlignment="Right" Margin="0,0,0,8"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AddWheelMappingCommand}"
                        Background="#1A4A38" BorderBrush="#266D53" Foreground="White" FontWeight="SemiBold" Padding="12,7" CornerRadius="6"
                        ToolTip.Tip="Adds a new unbound row - click it, then press a button or move an axis to bind it."/>
                <Grid Grid.Row="1" ColumnDefinitions="32, 1.8*, 0.9*, 1.4*, 1.8*, 1.4*, 1*, 36" Margin="14,0,14,8">
                    <Border Grid.ColumnSpan="8" BorderThickness="0,0,0,2" BorderBrush="#262D3D" Padding="0,0,0,6"/>
                    <TextBlock Grid.Column="0" Text="Select" FontSize="11" FontWeight="SemiBold" Foreground="#8B95A5" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="Physical Key / Axis" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="Type" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="3" Text="Virtual Player Slot" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="4" Text="Channel" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="5" Text="Dead Zone" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="6" Text="Calibration" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <shared:DeviceMappingGroupsPanel Grid.Row="2" ItemsSource="{Binding GroupEntries}" DeviceIconGlyph="🛞"/>
            </Grid>

            <!-- Wheel Settings: rotation + force feedback tuning for the device picked above. -->
            <ScrollViewer IsVisible="{Binding IsWheelSettingsTabSelected}">
                <StackPanel Spacing="10" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="No wheel/pedal devices bound yet - use Button Mapping to bind one first." Foreground="#8B95A5" FontSize="12"
                               IsVisible="{Binding !HasSelectedDevice}" Margin="4,8"/>

                    <StackPanel Spacing="10" IsVisible="{Binding HasSelectedDevice}">
                    <StackPanel Spacing="10" DataContext="{Binding SelectedWheelSettings}">
                    <StackPanel Spacing="10" x:DataType="models:WheelDeviceSettings">
                        <Border Classes="card" IsVisible="{Binding !$parent[UserControl].((vm:DeviceMappingViewModel)DataContext).IsSelectedDeviceForceFeedbackCapable}">
                            <TextBlock Text="This device isn't reporting force-feedback support to Windows - rotation/deadzone settings still apply, but effects (spring/damper/friction/etc.) won't reach it." Foreground="#FFAAAA" FontSize="12" TextWrapping="Wrap"/>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Rotation" FontWeight="SemiBold" FontSize="12" Foreground="#BAC2DE"/>
                                <TextBlock Text="Degrees of physical lock-to-lock rotation this wheel is configured for (set on the wheel's own firmware/driver - this doesn't change that, only how ECCR scales spring-effect torque near the limits)." FontSize="11" Foreground="#8B95A5" TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="*, 56">
                                    <Slider Grid.Column="0" Minimum="90" Maximum="1080" TickFrequency="90" IsSnapToTickEnabled="True" Value="{Binding RotationDegrees}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RotationDegrees, StringFormat='{}{0}°'}" FontSize="12" Foreground="#D0D0E0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="Force Feedback" FontWeight="SemiBold" FontSize="12" Foreground="#BAC2DE" VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding ForceFeedbackEnabled}" OnContent="Enabled" OffContent="Disabled"/>
                                </Grid>
                                <TextBlock Text="Relays a game's force-feedback effects from its virtual wheel back to this physical wheel in real time." FontSize="11" Foreground="#8B95A5" TextWrapping="Wrap"/>

                                <StackPanel Spacing="10" IsEnabled="{Binding ForceFeedbackEnabled}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Strength" FontSize="11" Foreground="#8B95A5"/>
                                        <Grid ColumnDefinitions="*, 50">
                                            <Slider Grid.Column="0" Minimum="0" Maximum="200" Value="{Binding ForceFeedbackStrengthPercent}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ForceFeedbackStrengthPercent, StringFormat='{}{0}%'}" FontSize="12" Foreground="#D0D0E0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                                        <TextBlock Grid.Column="0" Text="Spring (center-seeking force)" FontSize="12" Foreground="#D0D0E0" VerticalAlignment="Center"/>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding SpringEffectEnabled}" OnContent="" OffContent=""/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Grid.Column="0" Text="Damper (velocity resistance)" FontSize="12" Foreground="#D0D0E0" VerticalAlignment="Center"/>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding DamperEffectEnabled}" OnContent="" OffContent=""/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Grid.Column="0" Text="Friction" FontSize="12" Foreground="#D0D0E0" VerticalAlignment="Center"/>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding FrictionEffectEnabled}" OnContent="" OffContent=""/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Grid.Column="0" Text="Invert Force Direction" FontSize="12" Foreground="#D0D0E0" VerticalAlignment="Center"/>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding InvertForce}" OnContent="" OffContent=""/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Cloaking" FontWeight="SemiBold" FontSize="12" Foreground="#BAC2DE"/>
                                <TextBlock Text="For force feedback and full remapping to be authoritative, games must only see ECCR's virtual wheel - hide this device's raw input from other applications via HidHide." FontSize="11" Foreground="#8B95A5" TextWrapping="Wrap"/>
                                <Button Content="🛡 Open HidHide Cloaking" Command="{Binding $parent[UserControl].((vm:DeviceMappingViewModel)DataContext).OpenHidHideCommand}"
                                        Background="#1F283C" BorderBrush="#3D4B6E" Foreground="White" Padding="12,8" CornerRadius="6" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Panel>
    </Grid>
</UserControl>
