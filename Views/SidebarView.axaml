<!--
    Collapsible left sidebar: icon-only when collapsed, icon+label when expanded. Bound
    directly to MainWindowViewModel (no dedicated SidebarViewModel needed - it only reads
    PrimaryNavItems/UtilityNavItems/IsSidebarCollapsed and calls NavigateToCommand). Row
    templates use the "#SidebarRoot.((vm:MainWindowViewModel)DataContext).X" compiled-binding
    pattern since each row's own DataContext is a NavItem, not MainWindowViewModel.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ECCR.ViewModels"
             xmlns:models="using:ECCR.Models"
             xmlns:converters="using:ECCR.Converters"
             xmlns:avc="using:Avalonia.Data.Converters"
             mc:Ignorable="d"
             d:DesignWidth="220" d:DesignHeight="700"
             x:Class="ECCR.Views.SidebarView"
             x:DataType="vm:MainWindowViewModel"
             x:Name="SidebarRoot">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <UserControl.Resources>
        <converters:BoolToSidebarWidthConverter x:Key="BoolToSidebarWidthConverter"/>
    </UserControl.Resources>

    <Border Background="#0B0E15" BorderBrush="#20283C" BorderThickness="0,0,1,0"
            Width="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToSidebarWidthConverter}}">
        <Grid RowDefinitions="Auto, *, Auto">

            <!-- Logo / collapse toggle -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="12,14,12,10">
                <Viewbox Grid.Column="0" Width="24" Height="24" VerticalAlignment="Center">
                    <Canvas Width="48" Height="48">
                        <Ellipse Canvas.Left="2" Canvas.Top="2" Width="44" Height="44" Stroke="#3E7BFA" StrokeThickness="3.5" Fill="#121620"/>
                        <Rectangle Canvas.Left="12" Canvas.Top="14" Width="24" Height="20" RadiusX="6" RadiusY="6" Fill="#1E2B45" Stroke="#00E599" StrokeThickness="1.5"/>
                        <Rectangle Canvas.Left="16" Canvas.Top="21" Width="4" Height="6" Fill="#BAC2DE"/>
                        <Rectangle Canvas.Left="15" Canvas.Top="22" Width="6" Height="4" Fill="#BAC2DE"/>
                        <Ellipse Canvas.Left="28" Canvas.Top="20" Width="3" Height="3" Fill="#FF4D6D"/>
                        <Ellipse Canvas.Left="26" Canvas.Top="23" Width="3" Height="3" Fill="#3E7BFA"/>
                        <Ellipse Canvas.Left="30" Canvas.Top="23" Width="3" Height="3" Fill="#00E599"/>
                        <Ellipse Canvas.Left="28" Canvas.Top="26" Width="3" Height="3" Fill="#FFB900"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Grid.Column="1" Text="ECCR" FontWeight="Bold" FontSize="15" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"
                           IsVisible="{Binding !IsSidebarCollapsed}"/>
                <Button Grid.Column="2" Content="☰" Command="{Binding ToggleSidebarCollapsedCommand}"
                        Background="Transparent" Foreground="#8B95A5" Padding="6,4" FontSize="14"/>
            </Grid>

            <!-- Primary nav -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding PrimaryNavItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:NavItem">
                            <Button Classes="navItem" Classes.navItemSelected="{Binding IsSelected}"
                                    Command="{Binding #SidebarRoot.((vm:MainWindowViewModel)DataContext).NavigateToCommand}"
                                    CommandParameter="{Binding Page}">
                                <Grid ColumnDefinitions="Auto, *">
                                    <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontSize="16" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12.5" VerticalAlignment="Center" Margin="8,0,0,0"
                                               IsVisible="{Binding #SidebarRoot.((vm:MainWindowViewModel)DataContext).IsSidebarCollapsed, Converter={x:Static avc:BoolConverters.Not}}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Utility nav (HidHide, Auto Bind, About, Settings) -->
            <StackPanel Grid.Row="2" Margin="0,8,0,10">
                <Border Height="1" Background="#1F283C" Margin="12,0,12,8"/>
                <ItemsControl ItemsSource="{Binding UtilityNavItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:NavItem">
                            <Button Classes="navItem" Classes.navItemSelected="{Binding IsSelected}"
                                    Command="{Binding #SidebarRoot.((vm:MainWindowViewModel)DataContext).NavigateToCommand}"
                                    CommandParameter="{Binding Page}">
                                <Grid ColumnDefinitions="Auto, *">
                                    <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontSize="16" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12.5" VerticalAlignment="Center" Margin="8,0,0,0"
                                               IsVisible="{Binding #SidebarRoot.((vm:MainWindowViewModel)DataContext).IsSidebarCollapsed, Converter={x:Static avc:BoolConverters.Not}}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
